// EMS Decision Engine
// v3.45 - actualSurplusW calculated from raw netGrid before clamp;
//          fixes solar surplus not detected when EV load subtraction pushes
//          netGridW to 0 even though grid is exporting
// v3.44 - EV session accumulator: tracks kWh, actual cost, public cost (50ct)
//          and saving vs public charger; resets on car disconnect; writes to
//          HA helpers via msg.evSession output on evMsg
// v3.43 - dc_amps only set when charging (0 when discharging);
//          dc_power only set when discharging (0 when charging)
// v3.42 - MAX_AMPS reduced to 100A
// v3.41 - MAX_AMPS reduced to 125A
// v3.40 - solar-aware charge rate removed during planned cheap window;
//          always charge at full amps when inChargingWindow=true
// v3.39 - SOC_CRITICAL lowered to 15%; critical charge capped at avg × 0.70;
//          night EV min 8A; EV solar surplus scaling; 6A cap during discharge
// v3.36b - night minimum raised to 8A; EV charges at min 8A during
//           00h-06h window, up to 10A when 3-phase headroom allows
// v3.36 - EV capped at 6A single phase when battery is discharging;
//          prevents EV scaling up during discharge and pulling extra from grid
// v3.35 - EV follows solar surplus during day: sizes amps to keep grid
//          import at 0; scales up on 3-phase when surplus allows >= 7A
// v3.34 - EV charging rules:
//          baseline 6A 24/7 (single phase L1 below 7A, 3-phase at 7A+);
//          night 00h-06h max 10A on 3-phase;
//          L1-only: cut after 3 cycles >18A OR instantly >20A;
//          3-phase switch-back: confirm all phases have headroom
// v3.28 - EV always respects grid phase limit; evSafeAmps caps all EV
//          charging at available phase headroom — including mandatory night window;
//          EV pauses if headroom < EV minimum (6A) to prevent blown fuse
// v3.27 - mandatory night charging 01h-06h at EV_NIGHT_AMPS (8A) regardless
//          of price; EV always charges at night when car is connected
// v3.26 - removed EV pause-on-battery-discharge guard; EV load subtraction
//          already prevents battery from covering EV consumption
// v3.25 - EV night mode 01h-06h: charge at up to 10A per phase when grid
//          headroom allows; rate limited by actual worst phase headroom
// v3.24 - EV blackout window 17h-19h: no EV charging during cooking peak hours
// v3.23 - EV cheapest hour fallback now requires price < avgPrice;
//          prevents EV charging when all remaining hours are above average
// v3.22 - EV output 2 always fires every cycle for diagnostics;
//          rate limiting moved to downstream EV Output Router node
// v3.21 - EV pause now uses switch.sloeierd_opladen off instead of 0A;
//          evMsg carries evCharging bool and zaptecValue separately
// v3.20 - EV charge load read from msg.EVChargeLoad (actual sensor) instead of
//          context-derived lastEvAmps; falls back to lastEvAmps if sensor unavailable
// v3.19 - Zaptec is 3-phase: evChargingW = lastEvAmps × GRID_VOLTAGE × 3;
//          EV_SOLAR_MIN_W and EV_SOLAR_EXIT_W updated for 3-phase load
// v3.18 - EV charger integrated: evChargingW subtracted from netGridW and
//          dischargeTargetW so battery never compensates for intentional EV load;
//          EV Charge Controller v1.1 appended — outputs [battery_msg, ev_msg]
// v3.17 - solar-aware charge rate: reduce grid charge amps proportionally
//          when solar forecast covers part of kwhNeeded; keeps grid import low
//          during cheap window while solar does the heavy lifting
// v3.16 - solar overfill pre-discharge: discharge to solarPreDischargeTargetSoC
//          when solar will fill battery before cheap window opens, creating room
//          for cheap grid charging at the lowest price of the day
// v3.15 - solar surplus charging suppressed during active discharge window;
//          discharge takes priority over surplus absorption when inDischargeWindow=true
// v3.14 - minimum discharge branch now suppressed when solar surplus
//          exceeds SOLAR_SUPPRESS_DISCHARGE_W; prevents draining battery before
//          planned discharge window when solar is already exporting
// v3.13 - fraction clamped to [0.1, 1.0] in scaled charge calc;
//          prevents negative dc_amps when priceRatio > 1 (price above avg)
// v3.12 - pre-discharge before upcoming negative price windows;
//          discharge to SOC_DISCHARGE_MIN when negative prices are forecast ahead
// v3.11 - negative price branch: solar production offsets grid draw;
//          target netGrid ~0 by reducing charge amps by solar available for battery
// v3.10 - negative price charging spread across full negative window;
//          rate = kwhNeeded / negPriceHoursRemaining instead of always max amps
// v3.9 - canCharge: removed isNegPrice override on SOC_MAX; battery never charges above 95%
// v3.8 - SOC_CRITICAL branch now also requires price <= chargeAbsMax (avg × 0.55);
//         prevents emergency charging at above-average prices when avgPrice is skewed early morning
// v3.7 - isPriceLow: planner window can now be overridden by ratio threshold;
//         dramatically cheap hours (price <= CHARGE_THRESHOLD × avg) always charge
//         regardless of planned window, so cheap hours outside the window aren't wasted
// v3.6 - SOC_CRITICAL check changed < to <= (was missing boundary at exactly 20%);
//         isPriceHigh now also guards currentPrice >= avgPrice to prevent discharging below avg
// v3.5 - canDischarge bug fixed (|| SOC_MAX always true), discharge amp calc fixed (removed ROUND_TRIP_EFF from discharge path)
// v3.4 - all fixed price thresholds replaced with ratios of today's average
// v3.3 - solar surplus canChargeSolar flag, never blocked by price or SoC threshold
// v3.2 - solar surplus before discharge, SOC_DISCHARGE_MIN 15%, gross import target
// v3.1 - SOC_DISCHARGE_MIN 15%, SOC_CRITICAL 20%
// v3.0 - P1 phase readings used directly

var EMS_VERSION = 'EMS v3.45';
var EV_VERSION  = 'EV v2.0';

var CFG = {
  MAX_AMPS:             100,  // safe limit
  BATTERY_VOLTAGE:      48,
  BATTERY_KWH:          40,
  SOC_MIN:              10,
  SOC_MAX:              95,
  SOC_DISCHARGE_MIN:    15,
  SOC_CRITICAL:         15,  // emergency charge threshold — below discharge floor
  CHARGE_THRESHOLD:     0.80,
  DISCHARGE_THRESHOLD:  1.20,
  CHARGE_ABS_RATIO:     0.55,
  DISCHARGE_ABS_RATIO:  0.55,
  DISCHARGE_OVERSHOOT:  1.25,
  EXPORT_BIAS_W:        800,
  HYSTERESIS:           0.05,
  SOLAR_SURPLUS_W:      500,
  SOLAR_SURPLUS_EXIT_W: 200,
  ROUND_TRIP_EFF:       0.85,
  GRID_MAX_A_PHASE:     18,
  GRID_VOLTAGE:         230,
  SAFETY_MARGIN_A:      2,
  MIN_DISCHARGE_A:      35,
  MIN_CHARGE_A:         10,  // minimum meaningful charge current (A)
  SOLAR_SUPPRESS_DISCHARGE_W: 500, // suppress min-discharge when solar surplus exceeds this
  EV_MAX_AMPS:          6,    // max EV charge amps per phase (3-phase — 6A on all 3 phases)
  EV_SOLAR_MIN_W:       4200, // min solar surplus to start EV charging (6A × 230V × 3 phases)
  EV_SOLAR_EXIT_W:      2400, // min solar surplus to keep EV charging (3-phase)
  EV_RATE_LIMIT_MS:     15 * 60 * 1000, // 15 min between Zaptec writes
  EV_PUBLIC_RATE:       0.50  // public charger reference rate (€/kWh)
};

var currentPrice     = parseFloat(msg.currentPrice) || 0;
var avgPrice         = parseFloat(msg.avgPrice)     || 0.10;
var inChargingWindow = msg.inChargingWindow;

var gridImport       = parseFloat(msg.gridImport) || 0;
var gridExport       = parseFloat(msg.gridExport) || 0;

// EV load subtraction: if EV is charging from grid, subtract that load so the
// battery doesn't compensate for intentional EV consumption.
// Use actual measured EV charge load from sensor (msg.EVChargeLoad) if available,
// fall back to last commanded amps × 3-phase voltage if sensor is unavailable.
var zaptecMode    = msg.zaptecMode || '';
var lastEvAmps    = context.get('evLastAmps') || 0;
var evChargingW   = (msg.EVChargeLoad !== undefined && msg.EVChargeLoad !== null)
  ? parseFloat(msg.EVChargeLoad) || 0     // actual measured W from sensor
  : lastEvAmps * CFG.GRID_VOLTAGE * 3;   // fallback: commanded amps × 3-phase

var rawNetGridW      = (gridImport - gridExport) * 1000 - evChargingW;
var netGridW         = Math.max(0, rawNetGridW);
var dischargeTargetW = Math.max(0, gridImport * 1000 - evChargingW);

var phaseL1kW  = parseFloat(msg.phaseL1)   || 0;
var phaseL2kW  = parseFloat(msg.phaseL2)   || 0;
var phaseL3kW  = parseFloat(msg.phaseL3)   || 0;
var pac1       = parseFloat(msg.pac1)       || 0;
var pac2       = parseFloat(msg.pac2)       || 0;
var pac3       = parseFloat(msg.pac3)       || 0;
var batterySoC = parseFloat(msg.batterySoC) || 50;

var negPriceHoursRemaining  = parseInt(msg.negPriceHoursRemaining)  || 1;
var inPreDischargeWindow         = msg.inPreDischargeWindow === true;
var inSolarPreDischargeWindow    = msg.inSolarPreDischargeWindow === true;
var solarPreDischargeTargetSoC   = parseFloat(msg.solarPreDischargeTargetSoC) || 15;
var kwhToFreeForSolar            = parseFloat(msg.kwhToFreeForSolar)    || 0;
var solarAfterCheapWindow        = parseFloat(msg.solarAfterCheapWindow)  || 0;
var kwhNeededForGrid             = parseFloat(msg.kwhNeededForGrid)        || 0;
var MIN_SOLAR_GRID_FRACTION      = 0.20;
var hoursUntilNegWindow     = parseFloat(msg.hoursUntilNegWindow) || 99;
var futureNegHoursCount     = parseInt(msg.futureNegHoursCount)   || 0;

var lastState    = context.get('lastState')    || 'idle';
var pendingState = context.get('pendingState') || 'idle';
var pendingCount = context.get('pendingCount') || 0;

var solarTotalW    = pac1 + pac2 + pac3;
// Use rawNetGridW (before clamp) to detect solar surplus correctly
// even when EV load subtraction pushes netGridW to 0
var actualSurplusW = (rawNetGridW < 0 && solarTotalW > 50)
  ? Math.min(Math.abs(rawNetGridW), solarTotalW) : 0;

var priceRatio  = avgPrice > 0 ? currentPrice / avgPrice : 1;
var isNegPrice  = currentPrice < 0;

// Dynamic thresholds based on today's average — no fixed euro amounts
var chargeAbsMax    = avgPrice * CFG.CHARGE_ABS_RATIO;
var dischargeAbsMin = avgPrice * CFG.DISCHARGE_ABS_RATIO;

var chargeRatioThreshold    = lastState === 'charging'    ? CFG.CHARGE_THRESHOLD    + CFG.HYSTERESIS : CFG.CHARGE_THRESHOLD;
var dischargeRatioThreshold = lastState === 'discharging' ? CFG.DISCHARGE_THRESHOLD - CFG.HYSTERESIS : CFG.DISCHARGE_THRESHOLD;

var isPriceLow;
var isPriceVeryLow = priceRatio <= CFG.CHARGE_THRESHOLD && currentPrice <= chargeAbsMax;  // ratio override
var chargeCriticalMax = avgPrice * 0.70;  // more lenient than chargeAbsMax for critical SoC
if (batterySoC <= CFG.SOC_CRITICAL && currentPrice < avgPrice && currentPrice <= chargeCriticalMax) {
  // Critical SoC — charge if price is reasonably cheap (below avg × 0.70)
  // Prevents charging at 90% of avg but allows charging at 70% of avg
  isPriceLow = true;
} else if (inChargingWindow === null) {
  // No planner data — use ratio fallback
  isPriceLow = isPriceVeryLow || isNegPrice;
} else {
  // Planner active — trust the window, but also charge if price is dramatically cheap
  // regardless of whether this hour was planned. Prevents wasting low-price hours
  // that fall outside the centered window (e.g. a cheap morning dip before 12h).
  isPriceLow = inChargingWindow || isPriceVeryLow || isNegPrice;
}

var isPriceHigh;
if (msg.inDischargeWindow === true) {
  // FIX: guard against planner flagging discharge hours below avg price
  isPriceHigh = currentPrice >= avgPrice && currentPrice >= dischargeAbsMin;
} else {
  isPriceHigh = priceRatio >= dischargeRatioThreshold && currentPrice >= dischargeAbsMin;
}

var canCharge      = batterySoC < CFG.SOC_MAX;  // FIX: removed isNegPrice override — never charge above SOC_MAX regardless of price
var canChargeSolar = batterySoC < CFG.SOC_MAX;
// FIX 1: was `(batterySoC > CFG.SOC_MIN || batterySoC > CFG.SOC_MAX) && ...`
//         `|| batterySoC > CFG.SOC_MAX` is almost never true and the || made the
//         first condition effectively ignored — now correctly just SOC_MIN guard.
var canDischarge   = batterySoC > CFG.SOC_MIN && batterySoC >= CFG.SOC_DISCHARGE_MIN;

var phaseL1A            = (phaseL1kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL2A            = (phaseL2kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL3A            = (phaseL3kW * 1000) / CFG.GRID_VOLTAGE;
var maxPhaseLoadA       = Math.max(phaseL1A, phaseL2A, phaseL3A);
var worstPhaseHeadroomA = Math.max(0, CFG.GRID_MAX_A_PHASE - maxPhaseLoadA - CFG.SAFETY_MARGIN_A);
var gridHeadroomW       = worstPhaseHeadroomA * CFG.GRID_VOLTAGE * 3;
var maxChargeFromGridA  = Math.round((gridHeadroomW / CFG.BATTERY_VOLTAGE) * CFG.ROUND_TRIP_EFF);
var maxAllowedChargeA   = Math.min(CFG.MAX_AMPS, maxChargeFromGridA);

var solarSurplusThreshold = lastState === 'charging' ? CFG.SOLAR_SURPLUS_EXIT_W : CFG.SOLAR_SURPLUS_W;

var CONFIRM_CYCLES = (isPriceLow || isPriceHigh || isNegPrice || (actualSurplusW > solarSurplusThreshold && canChargeSolar)) ? 1 : 2;

var charging    = false;
var discharging = false;
var targetAmps  = 0;
var reason      = '';

if (isNegPrice && canCharge) {
  // Step 1: spread charge across remaining negative price hours
  var usableCapacity  = CFG.BATTERY_KWH * ((CFG.SOC_MAX - CFG.SOC_MIN) / 100);
  var currentKwh      = CFG.BATTERY_KWH * ((batterySoC - CFG.SOC_MIN) / 100);
  var kwhHeadroom     = Math.max(0, usableCapacity - currentKwh);
  var targetKwPerHour = kwhHeadroom / negPriceHoursRemaining;
  var spreadAmps      = Math.round((targetKwPerHour * 1000) / CFG.BATTERY_VOLTAGE / CFG.ROUND_TRIP_EFF);

  // Step 2: offset grid draw with solar production available for battery.
  // homeLoadW = what the house is consuming right now (solar + grid - export).
  // solarForBattery = solar production beyond what home needs.
  // This reduces how many amps need to come from grid to hit the spread target,
  // keeping netGrid close to 0 — absorb solar rather than export at negative price.
  // homeLoad = solar production + net grid (import positive, export negative)
  // e.g. solar 6000W, exporting 2000W → netGrid -2000 → homeLoad 4000W
  // e.g. solar 2000W, importing 1000W → netGrid +1000 → homeLoad 3000W
  var homeLoadW        = solarTotalW + netGridW;
  var solarForBatteryW = Math.max(0, solarTotalW - homeLoadW);  // solar beyond home load available for battery
  var solarOffsetAmps  = Math.round(solarForBatteryW / CFG.BATTERY_VOLTAGE);
  var gridAmps         = Math.max(0, spreadAmps - solarOffsetAmps);  // grid contribution after solar offset
  var negAmps          = Math.max(CFG.MIN_CHARGE_A, Math.min(maxAllowedChargeA, spreadAmps));

  charging   = true;
  targetAmps = negAmps;
  reason     = 'Negative price (' + currentPrice.toFixed(3) + ' EUR/kWh) - charging at ' + targetAmps + ' A'
             + ' (' + negPriceHoursRemaining + ' neg-price hour(s) remaining,'
             + ' spreading ' + kwhHeadroom.toFixed(1) + ' kWh over window'
             + (solarOffsetAmps > 0 ? ', solar covers ~' + solarOffsetAmps + ' A, grid ~' + gridAmps + ' A' : '') + ')';

} else if (isPriceLow && canCharge) {
  var priceDiscount = 1 - priceRatio;
  var fraction      = Math.max(0.10, Math.min(1.0, 0.50 + (priceDiscount * 2.5)));
  charging = true;

  if (batterySoC <= CFG.SOC_CRITICAL) {
    targetAmps = maxAllowedChargeA;
    reason     = 'Critical SoC (' + batterySoC + '%) - charging at max ' + targetAmps + ' A (price ' + currentPrice.toFixed(3) + ' EUR below avg ' + avgPrice.toFixed(3) + ' EUR)';

  } else if (inChargingWindow) {
    // Cheap window — charge at full amps regardless of solar forecast.
    // Solar will contribute on top; grid fills the battery as fast as possible
    // while price is at its lowest. Never reduce rate during cheap window.
    targetAmps = Math.round(maxAllowedChargeA * fraction);
    reason     = 'Planner: cheapest window (' + currentPrice.toFixed(3) + ' EUR) - charging at ' + targetAmps + ' A. Hours: ' + (msg.plannedChargeHours || []).join('h,') + 'h';

  } else {
    targetAmps = Math.round(maxAllowedChargeA * fraction);
    reason     = 'Price override: ' + Math.round(priceRatio * 100) + '% of avg (' + currentPrice.toFixed(3) + ' EUR) below threshold - charging at ' + targetAmps + ' A outside planned window';
  }

} else if (actualSurplusW > solarSurplusThreshold && canChargeSolar && !msg.inDischargeWindow) {
  var surplusAmps = Math.round((actualSurplusW / CFG.BATTERY_VOLTAGE) / CFG.ROUND_TRIP_EFF);
  charging   = true;
  targetAmps = Math.min(CFG.MAX_AMPS, surplusAmps);
  reason     = 'Solar surplus ' + actualSurplusW.toFixed(0) + ' W (' + solarTotalW.toFixed(0) + ' W produced) - absorbing at ' + targetAmps + ' A';

} else if (inSolarPreDischargeWindow && canDischarge && batterySoC > solarPreDischargeTargetSoC) {
  // Solar overfill pre-discharge: solar will fill the battery before the cheap window opens.
  // Discharge now to solarPreDischargeTargetSoC to create room for cheap grid charging.
  var solarPreAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS,
    Math.round((kwhToFreeForSolar * 1000) / CFG.BATTERY_VOLTAGE)
  ));
  discharging = true;
  targetAmps  = solarPreAmps;
  reason      = 'Solar pre-discharge: solar will fill battery before cheap window'
              + ' - discharging ' + targetAmps + ' A'
              + ' (target SoC ' + solarPreDischargeTargetSoC + '%'
              + ', freeing ' + kwhToFreeForSolar.toFixed(1) + ' kWh for cheap grid charging)';

} else if (inPreDischargeWindow && canDischarge) {
  // Pre-discharge: negative price window is coming — empty the battery now to free
  // capacity for cheap/free charging. Discharge at a rate that reaches SOC_DISCHARGE_MIN
  // just before the negative window starts, spread across available pre-discharge hours.
  var preDischargeHoursCount = (msg.preDischargeHours || []).length || 1;
  var currentKwhPD   = CFG.BATTERY_KWH * ((batterySoC - CFG.SOC_MIN) / 100);
  var minKwhPD       = CFG.BATTERY_KWH * ((CFG.SOC_DISCHARGE_MIN - CFG.SOC_MIN) / 100);
  var kwhToDischarge = Math.max(0, currentKwhPD - minKwhPD);
  var targetKwPD     = kwhToDischarge / preDischargeHoursCount;
  var preAmps        = Math.round((targetKwPD * 1000) / CFG.BATTERY_VOLTAGE);
  var clampedPreAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS, preAmps));
  discharging = true;
  targetAmps  = clampedPreAmps;
  reason      = 'Pre-discharge: neg price in ' + hoursUntilNegWindow + 'h (' + futureNegHoursCount + ' neg hour(s))'
              + ' - discharging ' + targetAmps + ' A to free ' + kwhToDischarge.toFixed(1) + ' kWh'
              + ' over ' + preDischargeHoursCount + 'h (SoC ' + batterySoC + '% → ' + CFG.SOC_DISCHARGE_MIN + '%)';

} else if (isPriceHigh && canDischarge) {
  if (dischargeTargetW > 0) {
    var targetW = dischargeTargetW + CFG.EXPORT_BIAS_W;
    // FIX 2: removed / CFG.ROUND_TRIP_EFF — efficiency applies to charging only.
    //         discharge amps = DC watts needed ÷ DC bus voltage, then overshoot for lag.
    //         old formula inflated amps by factor of (OVERSHOOT / EFF) = 1.25/0.85 = ~1.47×
    //         new formula: (targetW / VOLTAGE) * OVERSHOOT only
    var neededAmps  = Math.round((targetW / CFG.BATTERY_VOLTAGE) * CFG.DISCHARGE_OVERSHOOT);
    var clampedAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS, neededAmps));
    discharging = true;
    targetAmps  = clampedAmps;
    reason      = 'High price (' + (priceRatio * 100).toFixed(0) + '% of avg, ' + currentPrice.toFixed(3) + ' EUR) - discharging ' + targetAmps + ' A to cover ' + dischargeTargetW.toFixed(0) + ' W gross import + ' + CFG.EXPORT_BIAS_W + ' W export bias' + (neededAmps < CFG.MIN_DISCHARGE_A ? ' (raised to minimum ' + CFG.MIN_DISCHARGE_A + ' A)' : '');
  } else if (actualSurplusW < CFG.SOLAR_SUPPRESS_DISCHARGE_W) {
    // Only export from battery when solar is not already covering export.
    // If solar surplus is large, preserve battery charge for the planned window.
    discharging = true;
    targetAmps  = CFG.MIN_DISCHARGE_A;
    reason      = 'High price (' + (priceRatio * 100).toFixed(0) + '% of avg, ' + currentPrice.toFixed(3) + ' EUR) - exporting ' + CFG.MIN_DISCHARGE_A + ' A to grid at peak price (solar export: ' + actualSurplusW.toFixed(0) + ' W)';
  } else {
    discharging = false;
    targetAmps  = 0;
    reason      = 'High price (' + (priceRatio * 100).toFixed(0) + '% of avg, ' + currentPrice.toFixed(3) + ' EUR) - solar exporting ' + actualSurplusW.toFixed(0) + ' W, battery idle (surplus > ' + CFG.SOLAR_SUPPRESS_DISCHARGE_W + ' W threshold)';
  }

} else {
  reason = 'Idle - SoC ' + batterySoC + '%, price ' + currentPrice.toFixed(3) + ' EUR (' + (priceRatio * 100).toFixed(0) + '% of avg), solar ' + solarTotalW.toFixed(0) + ' W, netGrid ' + netGridW.toFixed(0) + ' W | ' + (msg.plannerReason || 'no planner');
}

if (charging && discharging) {
  discharging = false;
  reason += ' [conflict resolved: charge wins]';
}
if (targetAmps === 0) {
  charging    = false;
  discharging = false;
}

context.set('lastState', charging ? 'charging' : discharging ? 'discharging' : 'idle');

var rawState = charging ? 'charging' : discharging ? 'discharging' : 'idle';
var confirmedState;
if (rawState === pendingState) {
  var newCount = pendingCount + 1;
  context.set('pendingCount', newCount);
  if (newCount >= CONFIRM_CYCLES) {
    confirmedState = rawState;
    context.set('lastState', rawState);
  } else {
    confirmedState = lastState;
    reason += ' [confirming ' + newCount + '/' + CONFIRM_CYCLES + ']';
  }
} else {
  context.set('pendingState', rawState);
  context.set('pendingCount', 1);
  confirmedState = lastState;
  reason += ' [pending change to ' + rawState + ' 1/' + CONFIRM_CYCLES + ']';
}

charging    = confirmedState === 'charging';
discharging = confirmedState === 'discharging';
targetAmps  = (charging || discharging) ? targetAmps : 0;

if (targetAmps === 0) {
  charging    = false;
  discharging = false;
}

// dc_amps = charging current (A) when charging, 0 when discharging
// dc_power = discharge power (W) when discharging, 0 when charging
var dc_amps  = charging   ? targetAmps : 0;
var dc_power = discharging ? targetAmps * CFG.BATTERY_VOLTAGE : 0;

msg.payload = {
  version:     EMS_VERSION + ' / Planner ' + (msg.plannerVersion || 'unknown'),
  dc_amps:     dc_amps,
  dc_power:    dc_power,
  charging:    charging,
  discharging: discharging,
  reason:      reason,
  planner: {
    inWindow:              msg.inChargingWindow,
    inDischargeWindow:     msg.inDischargeWindow,
    dischargeThreshold:    msg.dischargeThreshold || null,
    hoursNeeded:           msg.hoursNeeded,
    kwhNeeded:             msg.kwhNeeded,
    cheapestPrice:         msg.cheapestPrice,
    plannedHours:          msg.plannedChargeHours,
    plannedDischargeHours: msg.plannedDischargeHours,
    reason:                msg.plannerReason
  },
  inputs: {
    currentPrice:        currentPrice,
    avgPrice:            avgPrice,
    priceRatio:          parseFloat((priceRatio * 100).toFixed(1)),
    chargeAbsMax:        parseFloat(chargeAbsMax.toFixed(3)),
    dischargeAbsMin:     parseFloat(dischargeAbsMin.toFixed(3)),
    lastState:           lastState,
    batterySoC:          batterySoC,
    solarTotal_W:        solarTotalW,
    netGrid_W:           netGridW,
    dischargeTarget_W:   dischargeTargetW,
    actualSurplus_W:     actualSurplusW,
    phaseL1_A:           parseFloat(phaseL1A.toFixed(2)),
    phaseL2_A:           parseFloat(phaseL2A.toFixed(2)),
    phaseL3_A:           parseFloat(phaseL3A.toFixed(2)),
    maxPhaseLoad_A:      parseFloat(maxPhaseLoadA.toFixed(2)),
    worstHeadroom_A:     parseFloat(worstPhaseHeadroomA.toFixed(2)),
    gridHeadroom_W:      parseFloat(gridHeadroomW.toFixed(0)),
    maxAllowedCharge_A:  maxAllowedChargeA,
    evCharging_W:        evChargingW,
    evLastAmps:          lastEvAmps,
    evSensorUsed:        (msg.EVChargeLoad !== undefined && msg.EVChargeLoad !== null)
  },
  timestamp: new Date().toISOString()
};

node.status({
  fill:  charging ? 'green' : discharging ? 'red' : 'grey',
  shape: 'dot',
  text:  EMS_VERSION + ' ' + (charging ? 'CHG ' : discharging ? 'DCH ' : 'IDLE ') + targetAmps + 'A | SoC:' + batterySoC + '% | ' + currentPrice.toFixed(3) + 'EUR | solar:' + solarTotalW.toFixed(0) + 'W'
});

// ── EV Charge Controller v2.0 ─────────────────────────────────────────────
// EV charging rules:
//   BASELINE: always charge at minimum 6A (single phase L1) when car connected
//             unless L1 is overloaded — 6A is the 24h baseline, never goes lower
//   PHASE:    < 7A commanded → Zaptec uses L1 only → check L1 headroom only
//             >= 7A commanded → Zaptec uses 3-phase → check all 3 phases
//   NIGHT:    00h-06h max 10A on 3-phase when all phases have headroom
//   BLACKOUT: 17h-19h no charging (cooking peak)
//   L1 SAFETY: cut session after 3 cycles >18A, OR immediately >20A
//   RESUME:   back to 6A L1 when L1 drops below 18A again

var currentHour = new Date().getHours();

// ── Time windows ─────────────────────────────────────────────────────────────
var EV_BLACKOUT_START = 17;
var EV_BLACKOUT_END   = 19;
var EV_NIGHT_START    = 0;   // midnight
var EV_NIGHT_END      = 6;
var evInBlackout = currentHour >= EV_BLACKOUT_START && currentHour < EV_BLACKOUT_END;
var evInNight    = currentHour >= EV_NIGHT_START && currentHour < EV_NIGHT_END;

// ── Phase loads (true values — add back EV's own current share) ───────────────
var evCurrentPerPhase = lastEvAmps;  // 3-phase balanced → per-phase amps = commanded
var phaseL1LoadA = (phaseL1kW * 1000 / CFG.GRID_VOLTAGE) + evCurrentPerPhase;
var phaseL2LoadA = (phaseL2kW * 1000 / CFG.GRID_VOLTAGE) + evCurrentPerPhase;
var phaseL3LoadA = (phaseL3kW * 1000 / CFG.GRID_VOLTAGE) + evCurrentPerPhase;

// ── Solar surplus available for EV ──────────────────────────────────────────
// gridExportW = how much is currently being exported to grid (after EV load subtraction)
// This is free solar energy going to waste — EV should absorb it first.
// We leave a SOLAR_EV_MARGIN_W buffer to avoid oscillating at the boundary.
var SOLAR_EV_MARGIN_W  = 200;   // W buffer to prevent grid import oscillation
var gridExportW        = Math.max(0, (gridExport - gridImport) * 1000 - evChargingW);
// amps available per phase from solar surplus (3-phase distribution)
var solarSurplusPerPhaseA = Math.floor((gridExportW - SOLAR_EV_MARGIN_W) / CFG.GRID_VOLTAGE / 3);
// total export amps on single phase basis (for L1 check)
var solarSurplusL1A    = Math.floor((gridExportW - SOLAR_EV_MARGIN_W) / CFG.GRID_VOLTAGE);
var hasSolarSurplus    = gridExportW > SOLAR_EV_MARGIN_W;

// ── L1 overload detection (dual threshold with hysteresis) ────────────────────
var EV_L1_HARD_LIMIT     = 20;   // immediate session cut
var EV_L1_WARN_LIMIT     = 18;   // soft warning — reduce + count cycles
var EV_L1_OVERLOAD_CYCLES = 3;   // cycles at warn before cutting session

var l1HardOverload = phaseL1LoadA > EV_L1_HARD_LIMIT;
var l1WarnOverload = phaseL1LoadA > EV_L1_WARN_LIMIT && !l1HardOverload;
var l1OverloadCount = context.get('l1OverloadCount') || 0;
if (l1WarnOverload) { l1OverloadCount++; } else { l1OverloadCount = 0; }
context.set('l1OverloadCount', l1OverloadCount);
// Persistent cut when: hard limit exceeded (instant) OR warn limit for N cycles
var l1SessionCut = l1HardOverload || (l1WarnOverload && l1OverloadCount >= EV_L1_OVERLOAD_CYCLES);

// ── Phase headroom calculation ────────────────────────────────────────────────
// L1 headroom (for single-phase mode, < 7A)
var l1HeadroomA = Math.max(0, EV_L1_HARD_LIMIT - phaseL1LoadA);

// 3-phase headroom (worst of all 3 phases)
var l2HeadroomA = Math.max(0, EV_L1_HARD_LIMIT - phaseL2LoadA);
var l3HeadroomA = Math.max(0, EV_L1_HARD_LIMIT - phaseL3LoadA);
var worst3PhaseA = Math.min(l1HeadroomA, l2HeadroomA, l3HeadroomA);

// ── Determine safe amps and phase mode ───────────────────────────────────────
// Zaptec rules: commanded < 7A → L1 only; commanded >= 7A → 3-phase
// Night max: 10A on 3-phase
// Baseline: always 6A minimum (L1 only) unless L1 session cut
var EV_MIN_AMPS      = 6;   // Zaptec minimum — always target this as baseline
var EV_3PHASE_MIN_A  = 7;   // 3-phase kicks in at this threshold
var EV_NIGHT_MAX     = 10;  // max amps during night window
var EV_NIGHT_MIN     = 8;   // minimum amps during night window

var evSafeAmps;
var evPhaseMode;
var evCanCharge;

if (l1SessionCut) {
  // L1 persistently or acutely overloaded — end session
  evSafeAmps  = 0;
  evPhaseMode = 'paused-L1-overload';
  evCanCharge = false;

} else if (worst3PhaseA >= EV_3PHASE_MIN_A) {
  // All 3 phases have headroom for 3-phase charging
  // During night: max EV_NIGHT_MAX amps
  // During day with solar surplus: scale to surplus (keep grid at 0)
  // Otherwise: baseline EV_MIN_AMPS
  var maxAllowed;
  if (evInNight) {
    maxAllowed = EV_NIGHT_MAX;
    // Night minimum is 8A — override lower values
  } else if (hasSolarSurplus && solarSurplusPerPhaseA >= EV_3PHASE_MIN_A) {
    // Size to solar surplus — add current EV amps back since they're already in export calc
    maxAllowed = Math.min(16, solarSurplusPerPhaseA + evCurrentPerPhase);
  } else {
    maxAllowed = EV_MIN_AMPS;
  }
  var candidate3 = Math.min(maxAllowed, Math.floor(worst3PhaseA));
  if (candidate3 >= EV_3PHASE_MIN_A) {
    // Enough for 3-phase
    evSafeAmps  = candidate3;
    evPhaseMode = '3-phase';
  } else {
    // Headroom allows 3-phase but target is below 7A threshold — use L1 at 6A baseline
    evSafeAmps  = EV_MIN_AMPS;
    evPhaseMode = 'single-phase-L1';
  }
  // Enforce night minimum: at least 8A if night and can charge
  if (evInNight && evCanCharge && evSafeAmps < EV_NIGHT_MIN && !l1SessionCut) {
    evSafeAmps  = EV_NIGHT_MIN;
    evPhaseMode = '3-phase';  // 8A always triggers 3-phase (>= 7A threshold)
  }
  evCanCharge = true;

} else {
  // Not enough headroom for 3-phase — use L1 single phase
  // Solar surplus on L1: scale up if surplus allows, otherwise baseline 6A
  if (hasSolarSurplus && solarSurplusL1A + evCurrentPerPhase > EV_MIN_AMPS && !evInNight) {
    // Size to L1 surplus but stay below 7A (above 7 would trigger 3-phase)
    evSafeAmps = Math.min(EV_3PHASE_MIN_A - 1, solarSurplusL1A + evCurrentPerPhase);
    evSafeAmps = Math.max(EV_MIN_AMPS, evSafeAmps);
  } else if (evInNight) {
    // At night, try to get at least EV_NIGHT_MIN even on L1 if 3-phase not available
    // Stay below 7A to remain on single phase (safety — not enough 3-phase headroom)
    evSafeAmps = Math.min(EV_3PHASE_MIN_A - 1, EV_NIGHT_MIN - 1);  // max 6A on L1
    evSafeAmps = Math.max(EV_MIN_AMPS, evSafeAmps);  // floor at 6A
  } else {
    evSafeAmps = EV_MIN_AMPS;  // 6A baseline on L1
  }
  evPhaseMode = 'single-phase-L1';
  evCanCharge = true;
}

// ── Car connected? ────────────────────────────────────────────────────────────
var evLastWriteTime = context.get('evLastWriteTime') || 0;
var evTimeSince     = new Date().getTime() - evLastWriteTime;

var evCarConnected = (
  zaptecMode === 'connected_charging'   ||
  zaptecMode === 'connected_finished'   ||
  zaptecMode === 'connected_requesting' ||
  zaptecMode === 'waiting'
);

// ── EV Decision ───────────────────────────────────────────────────────────────
var evTargetAmps = 0;
var evReason     = '';

if (!evCarConnected) {
  evTargetAmps = 0;
  evReason     = 'Car not connected (' + (zaptecMode || 'unknown') + ')';

} else if (!evCanCharge) {
  // L1 overloaded — cut session
  evTargetAmps = 0;
  evReason     = (l1HardOverload ? 'L1 instant overload' : 'L1 persistent overload')
               + ' (' + phaseL1LoadA.toFixed(1) + ' A) — session cut to protect fuse';

} else if (evInBlackout) {
  // Blackout window — but still send minimum 6A to keep session alive
  // Only fully pause if L1 headroom is insufficient
  evTargetAmps = EV_MIN_AMPS;
  evPhaseMode  = 'single-phase-L1';
  evReason     = 'Blackout window ' + EV_BLACKOUT_START + 'h-' + EV_BLACKOUT_END + 'h (cooking peak) - maintaining ' + evTargetAmps + 'A minimum [L1]';

} else {
  // Normal charging — always at least 6A (baseline), up to evSafeAmps
  // When battery is discharging, cap at 6A single phase to avoid pulling extra from grid
  if (discharging) {
    evTargetAmps = EV_MIN_AMPS;
    evPhaseMode  = 'single-phase-L1';
  } else {
    evTargetAmps = evSafeAmps;
  }

  if (evInNight && evPhaseMode === '3-phase') {
    evReason = 'Night charging (' + currentPrice.toFixed(3) + ' EUR) - ' + evTargetAmps + 'A [3-phase, max ' + EV_NIGHT_MAX + 'A] (headroom: L1=' + l1HeadroomA.toFixed(0) + ' L2=' + l2HeadroomA.toFixed(0) + ' L3=' + l3HeadroomA.toFixed(0) + ')';
  } else if (evPhaseMode === '3-phase') {
    evReason = 'Charging ' + evTargetAmps + 'A [3-phase] (headroom: worst=' + Math.floor(worst3PhaseA) + 'A)';
  } else {
    evReason = 'Charging ' + evTargetAmps + 'A [L1 single-phase] (L1 headroom: ' + l1HeadroomA.toFixed(0) + 'A)';
  }

  // Annotate reason with price/solar context
  if (discharging) {
    evReason += ' — battery discharging, capped at 6A baseline';
  } else if (inChargingWindow && currentPrice <= chargeAbsMax) {
    evReason += ' — cheap price window (' + currentPrice.toFixed(3) + ' EUR)';
  } else if (isPriceVeryLow) {
    evReason += ' — price override (' + currentPrice.toFixed(3) + ' EUR, ' + Math.round(priceRatio*100) + '% of avg)';
  } else if (hasSolarSurplus) {
    evReason += ' — solar surplus ' + gridExportW.toFixed(0) + 'W exported (' + currentPrice.toFixed(3) + ' EUR)';
  } else {
    evReason += ' — baseline (' + currentPrice.toFixed(3) + ' EUR)';
  }
}

// ── EV Session accumulator ────────────────────────────────────────────────────
// Tracks kWh and cost since car connected. Resets on disconnect.
// Uses EVChargeLoad (W) and cycle interval to estimate kWh per cycle.
var evLastCycleTime = context.get('evLastCycleTime') || 0;
var evNowMs         = new Date().getTime();
var evCycleSeconds  = evLastCycleTime > 0 ? (evNowMs - evLastCycleTime) / 1000 : 0;
context.set('evLastCycleTime', evNowMs);

// Reset session when car disconnects
var evWasConnected = context.get('evWasConnected') || false;
if (!evCarConnected && evWasConnected) {
    // Car just disconnected — reset session
    context.set('evSessionKwh',    0);
    context.set('evSessionCostAct', 0);
    context.set('evSessionCostPub', 0);
}
context.set('evWasConnected', evCarConnected);

// Accumulate kWh and cost if EV is charging
var evSessionKwh     = context.get('evSessionKwh')     || 0;
var evSessionCostAct = context.get('evSessionCostAct') || 0;
var evSessionCostPub = context.get('evSessionCostPub') || 0;

var evChargingNowW = parseFloat(msg.EVChargeLoad) || 0;
if (evCarConnected && evChargingNowW > 0 && evCycleSeconds > 0 && evCycleSeconds < 300) {
    var evCycleKwh    = (evChargingNowW / 1000) * (evCycleSeconds / 3600);
    evSessionKwh     += evCycleKwh;
    evSessionCostAct += evCycleKwh * currentPrice;
    evSessionCostPub += evCycleKwh * CFG.EV_PUBLIC_RATE;
    context.set('evSessionKwh',     evSessionKwh);
    context.set('evSessionCostAct', evSessionCostAct);
    context.set('evSessionCostPub', evSessionCostPub);
}

// Instantaneous rates (€/h)
var evInstantKw      = evChargingNowW / 1000;
var evInstantCostAct = evInstantKw * currentPrice;          // €/h at current price
var evInstantCostPub = evInstantKw * CFG.EV_PUBLIC_RATE;   // €/h at public rate
var evInstantSaving  = evInstantCostPub - evInstantCostAct; // saving vs public €/h
var evSessionSaving  = evSessionCostPub - evSessionCostAct; // total saving this session

// ── Rate limit ────────────────────────────────────────────────────────────────
var evShouldWrite = (evTargetAmps !== lastEvAmps) || (evTimeSince >= CFG.EV_RATE_LIMIT_MS);
if (evShouldWrite) {
  context.set('evLastWriteTime', new Date().getTime());
  context.set('evLastAmps', evTargetAmps);
}

// ── Build EV output message ───────────────────────────────────────────────────
var evCharging = evTargetAmps > 0;

var evMsg = {
  payload: {
    version:      EV_VERSION,
    targetAmps:   parseFloat(evTargetAmps),
    evCharging:   evCharging,
    carConnected: evCarConnected,
    reason:       evReason,
    shouldWrite:  evShouldWrite,
    inputs: {
      zaptecMode:       zaptecMode,
      currentPrice:     currentPrice,
      avgPrice:         avgPrice,
      surplus_W:        actualSurplusW,
      lastEvAmps:       lastEvAmps,
      cheapestHour:     msg.cheapestHour,
      cheapestPrice:    msg.cheapestPrice,
      currentHour:      currentHour,
      evInBlackout:     evInBlackout,
      evInNight:        evInNight,
      evPhaseMode:      evPhaseMode,
      evSafeAmps:       evSafeAmps,
      evCanCharge:      evCanCharge,
      phaseL1LoadA:     parseFloat(phaseL1LoadA.toFixed(2)),
      phaseL2LoadA:     parseFloat(phaseL2LoadA.toFixed(2)),
      phaseL3LoadA:     parseFloat(phaseL3LoadA.toFixed(2)),
      l1HeadroomA:      parseFloat(l1HeadroomA.toFixed(1)),
      l2HeadroomA:      parseFloat(l2HeadroomA.toFixed(1)),
      l3HeadroomA:      parseFloat(l3HeadroomA.toFixed(1)),
      worst3PhaseA:     parseFloat(worst3PhaseA.toFixed(1)),
      l1HardOverload:   l1HardOverload,
      l1WarnOverload:   l1WarnOverload,
      l1OverloadCount:  l1OverloadCount,
      l1SessionCut:     l1SessionCut,
      gridExportW:      parseFloat(gridExportW.toFixed(0)),
      solarSurplusPerPhaseA: solarSurplusPerPhaseA,
      hasSolarSurplus:  hasSolarSurplus,
      timeSince_s:        Math.round(evTimeSince / 1000)
    },
    session: {
      kwh:          parseFloat(evSessionKwh.toFixed(3)),
      costActual:   parseFloat(evSessionCostAct.toFixed(4)),
      costPublic:   parseFloat(evSessionCostPub.toFixed(4)),
      saving:       parseFloat(evSessionSaving.toFixed(4)),
      instantKw:    parseFloat(evInstantKw.toFixed(3)),
      instantCostAct: parseFloat(evInstantCostAct.toFixed(4)),
      instantCostPub: parseFloat(evInstantCostPub.toFixed(4)),
      instantSaving:  parseFloat(evInstantSaving.toFixed(4))
    }
  },
  evTargetAmps:  evTargetAmps,
  evCharging:    evCharging,
  evShouldWrite:      evShouldWrite,
  zaptecValue:        parseFloat(evTargetAmps),
  evSessionKwh:       parseFloat(evSessionKwh.toFixed(3)),
  evSessionCostAct:   parseFloat(evSessionCostAct.toFixed(4)),
  evSessionCostPub:   parseFloat(evSessionCostPub.toFixed(4)),
  evSessionSaving:    parseFloat(evSessionSaving.toFixed(4)),
  evInstantCostAct:   parseFloat(evInstantCostAct.toFixed(4)),
  evInstantCostPub:   parseFloat(evInstantCostPub.toFixed(4))
};

return [ msg, evMsg ];
