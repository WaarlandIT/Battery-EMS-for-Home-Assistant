// EMS Decision Engine
// v3.94 - EV v2.23: fixes from the second code review —
//          Battery
//          (1) missing sensor data is no longer read as a number: an unknown
//              price was 0 EUR (→ grid charging at 100A as "price override"),
//              an unknown SoC was 50%, unknown meter values were 0 A. Now:
//              price or average unknown → no price-based charge or discharge;
//              SoC unknown for more than 5 min → battery idle; DSMR values
//              unknown → battery idle and EV at the 6A baseline
//          (2) the battery's own power is added back to the grid readings
//              (CFG.COMPENSATE_OWN_POWER). The charge limit, the discharge
//              target and the solar surplus were all calculated from readings
//              that already contained the battery's own effect, so the
//              setpoints hunted (charging one run in three, discharge jumping
//              between 1.7 and 2.6 kW against a 3 kW load)
//          (3) solar surplus charging multiplies by the efficiency instead of
//              dividing — it asked for ~18% more than the surplus and pulled
//              the rest from the grid
//          (4) inside the planner's charge window the battery charges at the
//              full allowed rate — the planner sizes the window for that rate;
//              the price-scaled rate is kept for charging outside the window
//          (5) pre-discharge before negative prices stops at the planner's
//              msg.preDischargeTargetSoC (what the negative window can refill)
//          (6) solar pre-discharge spreads the energy over the hours that are
//              left (was kWh used as kW: anything above 4.8 kWh meant 100A)
//          (7) state changes are confirmed on the second run, as they always
//              were in practice — the CONFIRM_CYCLES 1-or-2 logic had no effect
//          (8) the 97% hard stop only reports when it really blocks charging;
//              it no longer overwrites the reason while discharging
//          (9) current solar production is stored in flow context for the
//              planner (no separate "Set solarNow" node needed)
//          EV
//          (10) the night minimum of 8A no longer overrides the phase headroom:
//               8A 3-phase needs 8A free on every phase, otherwise 6A single-
//               phase. It used to push a phase over 20A, be cut, wait out the
//               hold and do it again
//          (11) an overload trim leaves 0.5A margin instead of landing exactly
//               on the 20A limit, where meter noise confirmed a second overload
//          (12) ramp, overload hold, cut cooldown and nudge cooldown follow the
//               clock (one "poll" = 30 s of elapsed time), so they keep their
//               length when the flow is triggered more or less often
//          (13) a step up is sent at most once per 60 s; steps down are always
//               sent at once
//          (14) EV load estimate when the charger's power sensor is unavailable
//               (the fallback could never be reached)
//          (15) msg.evCanCharge on output 2 — false during a session cut and its
//               cooldown, for a switch node that really pauses the charger
// v3.93 - EV v2.22: charger decides, car data is optional — fixes a deadlock
//          introduced in v3.90: with ev_soc unavailable (guest car, or the
//          car integration offline) and Zaptec in connected_finished, the car
//          was treated as full and got 0A all night; at 0A it could never start,
//          so Zaptec stayed in connected_finished. Now:
//          - car data never forces 0A; a connected car always gets the normal
//            target (a full car simply draws nothing)
//          - "car full" only when ev_soc is known and >= 100%; it only stops the
//            finished-early nudges
//          - unknown SoC → treated as "may need charge": normal rules + nudges
//          - low-SoC priority still needs a known SoC (guest cars: normal rules)
// v3.92 - EV v2.21: EV low-SoC priority — when the car's SoC is below 55% the
//          EV charges at up to 12A 3-phase day and night (1A per ~15 min ramp),
//          regardless of price and battery state; switches off again at 60%.
//          All load rules still apply: 20A phase headroom, confirmed-overload
//          trim / soft cut / session cut, the 15-min hold and the 17–19h
//          blackout. Moves up from single-phase to 3-phase only with at least
//          8A headroom on every phase.
// v3.91 - EV v2.20: more stable night charging (3x25A fuse) —
//          (1) overload must be confirmed: any phase > 22A reacts at once,
//              20–22A only after two consecutive readings (single marginal
//              spikes like 20.02A are ignored)
//          (2) on 3 phases the EV is first trimmed by the excess and stays on
//              3 phases — an amp change does not restart the Zaptec session;
//              only if that would go below 7A does it switch to single-phase
//          (3) after any trim or soft cut the level is held for 30 polls
//              (~15 min) and the night minimum is suppressed, so it no longer
//              bounces back on the next poll
//          (4) single-phase EV load is on grid L2 in this installation
//              (CFG.EV_1PHASE_GRID_PHASE) — used for headroom, EV load
//              subtraction and labels
//          (5) single-phase EV is only session-cut when the overload is on
//              its own phase — house load on another phase can't be fixed by
//              the EV
// v3.90 - EV v2.19: fixes from full simulation review —
//          (1) battery state machine: amps computed for one direction could be
//              applied in the other during confirmation / forced idle (e.g.
//              discharging at charge amps for a cycle) and the idle step
//              between charge and discharge could be skipped; lastState is now
//              stored after confirmation and after the hard stop
//          (2) EV ramp: counter never reset after a step-up, so after the first
//              15 min the EV climbed 1A per poll; now max +1A per earned
//              window, counter resets on every step-up and does not accumulate
//              while no car is connected
//          (3) single-phase EV load (6A L1) is subtracted from the battery
//              discharge target and added back to L1 headroom
//          (4) headroom add-back only when EV current is actually flowing
//          (5) overload cut logic only runs when a car is connected
//          (6) negative-price minimum charge no longer overrides grid headroom
//          (7) Zaptec finished-early nudge limited to 3 attempts per episode
//              and skipped when ev_soc is unavailable
//          (8) l1HardOverload / l1WarnOverload exposed for the logger
// v3.89 - Bug fixes: evPhaseMode and evCanCharge now always set in all
//          branches of evSafeAmps determination — were undefined in the solar
//          surplus L1 fallback branch; dischargeTargetW corrected when EV not
//          charging (was subtracting 0, now clearly gridImport * 1000)
// v3.88 - Bug fixes: evLastAmps reset on disconnect; removed dead vars
// v3.87 - Cleanup: removed dead code (l1GraduatedCut, sixAmpResolves,
//          overloadTriggered, EV_L1_OVERLOAD_CYCLES, EV_MAX_AMPS,
//          EV_SOLAR_MIN_W, EV_SOLAR_EXIT_W); evJustFinished now has a
//          5-poll cooldown (~2.5 min) before nudging Zaptec again instead
//          of firing every cycle; session cut sends 5A (Zaptec minimum)
//          instead of 0A since Zaptec ignores 0A on the current entity
// v3.86 - EV v2.15: overload response based on current EV amps, not raw phase
//          threshold; phase > 20A with EV at 8A+ → drop to 6A L1 (soft cut);
//          phase > 20A with EV already at 6A → house caused overload → session
//          cut (0A); removes EV_L1_GRADUATED_LIMIT — no longer needed
// v3.85 - EV v2.14: graduated soft cut — phase load 20-22.5A drops to 8A
//          3-phase instead of jumping straight to 6A L1
// v3.84 - EV v2.13: force Zaptec write when connected_finished but evSoC < 100
// v3.83 - EV v2.12: evShouldWrite gated on evCarConnected
// v3.80 - EV v2.9: EV_RAMP_UP_POLLS raised 10 → 30 (~15 min at 30s polls)
// v3.79 - EV v2.8: phase headroom add-back; ramp-down lock
// v3.78 - EV v2.7: night discharge no longer caps EV
// v3.77 - EV v2.6: night discharge cap raised to 8A 3-phase
// v3.76 - Hard stop fix: batterySoC >= 97% forces dc_amps to 0
// v3.75 - (superseded)
// v3.74 - EV v2.5: daytime 3-phase up to 8A when isPriceVeryLow
// v3.73 - EV v2.4: EV_RAMP_UP_POLLS raised 4 → 10
// v3.72 - EV v2.3: daytime 3-phase ramp only at price <= 0
// v3.71 - EV v2.2: raw DSMR phase amps, no add-back
// v3.70 - EV v2.1: session cut only when house load alone >20A
// v3.69 - evCarFull sends 0A
// v3.68 - smarter overload response
// v3.65 - blackout window 17h-19h set to 5A

var EMS_VERSION = 'EMS v3.94';
var EV_VERSION = 'EV v2.23';

var CFG = {
  MAX_AMPS: 100,
  BATTERY_VOLTAGE: 48,
  BATTERY_KWH: 40,
  SOC_MIN: 10,
  SOC_MAX: 95,
  SOC_DISCHARGE_MIN: 15,
  SOC_CRITICAL: 15,
  CHARGE_THRESHOLD: 0.80,
  DISCHARGE_THRESHOLD: 1.20,
  CHARGE_ABS_RATIO: 0.55,
  DISCHARGE_ABS_RATIO: 0.55,
  DISCHARGE_OVERSHOOT: 1.25,
  EXPORT_BIAS_W: 800,
  HYSTERESIS: 0.05,
  SOLAR_SURPLUS_W: 500,
  SOLAR_SURPLUS_EXIT_W: 200,
  ROUND_TRIP_EFF: 0.85,
  GRID_MAX_A_PHASE: 18,
  GRID_VOLTAGE: 230,
  SAFETY_MARGIN_A: 2,
  MIN_DISCHARGE_A: 35,
  MIN_CHARGE_A: 10,
  SOLAR_SUPPRESS_DISCHARGE_W: 500,
  EV_RATE_LIMIT_MS: 15 * 60 * 1000,
  EV_PUBLIC_RATE: 0.50,
  EV_1PHASE_GRID_PHASE: 2,     // grid phase the Zaptec uses in single-phase mode (measured: L2)
  COMPENSATE_OWN_POWER: true,  // add the battery's own charge/discharge power back to the grid readings
  SOC_MAX_AGE_MS: 5 * 60 * 1000  // how long the last known SoC may be used when the sensor drops out
};

// ── Inputs ────────────────────────────────────────────────────────────────────
// A sensor that is 'unavailable' / 'unknown' gives null here — never a number.
var num = function (v) { var n = parseFloat(v); return isNaN(n) ? null : n; };
var nowMs = new Date().getTime();
var dataNotes = [];

var priceRaw = num(msg.currentPrice);
var avgRaw = num(msg.avgPrice);
var priceKnown = priceRaw !== null;
var avgKnown = avgRaw !== null && avgRaw > 0;
var pricesOk = priceKnown && avgKnown;      // needed for every price-ratio rule
var currentPrice = priceKnown ? priceRaw : 0;
var avgPrice = avgKnown ? avgRaw : 0.10;    // display value only when the average is unknown
if (!priceKnown) { dataNotes.push('price unknown'); }
else if (!avgKnown) { dataNotes.push('average price unknown'); }
var inChargingWindow = msg.inChargingWindow;

var gridImportRaw = num(msg.gridImport);
var gridExportRaw = num(msg.gridExport);
var phaseL1Raw = num(msg.phaseL1);
var phaseL2Raw = num(msg.phaseL2);
var phaseL3Raw = num(msg.phaseL3);
var metersKnown = gridImportRaw !== null && gridExportRaw !== null
  && phaseL1Raw !== null && phaseL2Raw !== null && phaseL3Raw !== null;
if (!metersKnown) { dataNotes.push('DSMR data unknown'); }
var gridImport = gridImportRaw !== null ? gridImportRaw : 0;
var gridExport = gridExportRaw !== null ? gridExportRaw : 0;

var EV_3PHASE_MIN_A = 7;

var zaptecMode = msg.zaptecMode || '';
var lastEvAmps = context.get('evLastAmps') || 0;
// Measured EV load (W). Sensor unavailable while Zaptec reports charging →
// estimate from the last commanded current.
var evLoadRaw = num(msg.EVChargeLoad);
var evSensorUsed = evLoadRaw !== null;
var evChargingW = evSensorUsed
  ? evLoadRaw
  : (zaptecMode === 'connected_charging'
    ? lastEvAmps * CFG.GRID_VOLTAGE * (lastEvAmps >= EV_3PHASE_MIN_A ? 3 : 1)
    : 0);

var evSoCRaw = parseFloat(msg.ev_soc);
var evSoCKnown = !isNaN(evSoCRaw);
var evSoC = evSoCKnown ? evSoCRaw : 0;
// "Car full" only when the SoC is actually known — unknown SoC (guest car, or car
// integration offline) must never block charging. Informational: stops nudges only.
var evCarFull = (zaptecMode === 'connected_finished') && evSoCKnown && evSoC >= 100;

var evCarConnected = (
  zaptecMode === 'connected_charging' ||
  zaptecMode === 'connected_finished' ||
  zaptecMode === 'connected_requesting' ||
  zaptecMode === 'waiting'
);
var evDrawing = zaptecMode === 'connected_charging' || evChargingW > 0;

var phaseL1kW = phaseL1Raw !== null ? phaseL1Raw : 0;
var phaseL2kW = phaseL2Raw !== null ? phaseL2Raw : 0;
var phaseL3kW = phaseL3Raw !== null ? phaseL3Raw : 0;
var pac1 = parseFloat(msg.pac1) || 0;
var pac2 = parseFloat(msg.pac2) || 0;
var pac3 = parseFloat(msg.pac3) || 0;

// Battery SoC. Sensor unavailable → last known value for up to SOC_MAX_AGE_MS,
// after that the SoC counts as unknown and the battery is kept idle.
var socRaw = num(msg.batterySoC);
if (socRaw !== null) {
  context.set('lastGoodSoC', socRaw);
  context.set('lastGoodSoCTime', nowMs);
} else {
  var lastGoodSoC = num(context.get('lastGoodSoC'));
  var lastGoodSoCTime = context.get('lastGoodSoCTime') || 0;
  if (lastGoodSoC !== null && (nowMs - lastGoodSoCTime) <= CFG.SOC_MAX_AGE_MS) { socRaw = lastGoodSoC; }
}
var socKnown = socRaw !== null;
var batterySoC = socKnown ? socRaw : 50;   // 50 is a display value only; nothing is done with it
if (!socKnown) { dataNotes.push('battery SoC unknown'); }

var lastState = context.get('lastState') || 'idle';
var pendingState = context.get('pendingState') || 'idle';
var pendingCount = context.get('pendingCount') || 0;

// ── The battery's own power ───────────────────────────────────────────────────
// What was sent to the inverter on the previous run. The grid readings of this
// run already contain that charge or discharge power; it is added back below so
// the new setpoint is based on the house, not on the battery's own effect.
var lastDcAmps = context.get('lastDcAmps') || 0;     // A, when charging
var lastDcPower = context.get('lastDcPower') || 0;   // W, when discharging
var ownChargeAcW = (CFG.COMPENSATE_OWN_POWER && lastState === 'charging')
  ? (lastDcAmps * CFG.BATTERY_VOLTAGE) / CFG.ROUND_TRIP_EFF : 0;
// Discharge: the setpoint is sent DISCHARGE_OVERSHOOT times higher than the power
// that is wanted, so what the battery really delivers is setpoint / overshoot.
var ownDischargeW = (CFG.COMPENSATE_OWN_POWER && lastState === 'discharging')
  ? lastDcPower / CFG.DISCHARGE_OVERSHOOT : 0;

var rawNetGridW = (gridImport - gridExport) * 1000 - evChargingW;
var netGridW = Math.max(0, rawNetGridW);

var phaseL1A = (phaseL1kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL2A = (phaseL2kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL3A = (phaseL3kW * 1000) / CFG.GRID_VOLTAGE;
var maxPhaseLoadA = Math.max(phaseL1A, phaseL2A, phaseL3A);
// Own charge current per phase, never more than the lightest phase actually
// shows — if the inverter draws less than commanded, less is added back.
var ownChargePhaseA = Math.min(ownChargeAcW / CFG.GRID_VOLTAGE / 3, Math.min(phaseL1A, phaseL2A, phaseL3A));
var worstPhaseHeadroomA = metersKnown
  ? Math.max(0, CFG.GRID_MAX_A_PHASE - maxPhaseLoadA - CFG.SAFETY_MARGIN_A + ownChargePhaseA)
  : 0;
var gridHeadroomW = worstPhaseHeadroomA * CFG.GRID_VOLTAGE * 3;
var maxChargeFromGridA = Math.floor((gridHeadroomW / CFG.BATTERY_VOLTAGE) * CFG.ROUND_TRIP_EFF);
var maxAllowedChargeA = Math.min(CFG.MAX_AMPS, maxChargeFromGridA);

// EV draws on all phases in 3-phase mode; in single-phase mode only on the
// charger's single phase (CFG.EV_1PHASE_GRID_PHASE — L2 in this installation)
var evIs3PhB = lastEvAmps >= EV_3PHASE_MIN_A;
var evContribB = function (p) { return (evIs3PhB || p === CFG.EV_1PHASE_GRID_PHASE) ? lastEvAmps : 0; };
var homeL1W = Math.max(0, phaseL1A - evContribB(1)) * CFG.GRID_VOLTAGE;
var homeL2W = Math.max(0, phaseL2A - evContribB(2)) * CFG.GRID_VOLTAGE;
var homeL3W = Math.max(0, phaseL3A - evContribB(3)) * CFG.GRID_VOLTAGE;
var homeImportW = homeL1W + homeL2W + homeL3W;
var dischargeTargetW;
if (ownDischargeW > 0) {
  // Already discharging: house demand = net grid (without the EV) + what the
  // battery itself is delivering right now
  dischargeTargetW = Math.max(0, rawNetGridW + ownDischargeW);
} else if (evChargingW > 0) {
  dischargeTargetW = Math.max(0, homeImportW);        // EV charging: use house-only import
} else {
  dischargeTargetW = Math.max(0, gridImport * 1000);  // no EV: full grid import is the target
}

var negPriceHoursRemaining = Math.max(0.25, parseFloat(msg.negPriceHoursRemaining) || 1);
var inPreDischargeWindow = msg.inPreDischargeWindow === true;
var inSolarPreDischargeWindow = msg.inSolarPreDischargeWindow === true;
var solarPreDischargeTargetSoC = parseFloat(msg.solarPreDischargeTargetSoC) || 15;
var preDischargeTargetSoC = Math.max(CFG.SOC_DISCHARGE_MIN, parseFloat(msg.preDischargeTargetSoC) || CFG.SOC_DISCHARGE_MIN);
var kwhToFreeForSolar = parseFloat(msg.kwhToFreeForSolar) || 0;
var hoursUntilNegWindow = parseFloat(msg.hoursUntilNegWindow) || 99;
var futureNegHoursCount = parseInt(msg.futureNegHoursCount) || 0;

var solarTotalW = pac1 + pac2 + pac3;
// For the planner's solar-overfill estimate on its next run
if (typeof flow !== 'undefined') {
  flow.set('emsSolarNowW', solarTotalW);
  flow.set('emsSolarNowTs', nowMs);
}

// Solar surplus = what would be exported if the battery were not charging
var surplusRawW = ownChargeAcW - rawNetGridW;
var actualSurplusW = (surplusRawW > 0 && solarTotalW > 50)
  ? Math.min(surplusRawW, solarTotalW) : 0;

var priceRatio = pricesOk ? currentPrice / avgPrice : 1;
var isNegPrice = priceKnown && currentPrice < 0;

var chargeAbsMax = avgPrice * CFG.CHARGE_ABS_RATIO;
var dischargeAbsMin = avgPrice * CFG.DISCHARGE_ABS_RATIO;

var dischargeRatioThreshold = lastState === 'discharging' ? CFG.DISCHARGE_THRESHOLD - CFG.HYSTERESIS : CFG.DISCHARGE_THRESHOLD;

var isPriceLow;
var isPriceVeryLow = pricesOk && priceRatio <= CFG.CHARGE_THRESHOLD && currentPrice <= chargeAbsMax;

var currentHourInt = new Date().getHours();
var cheapestHourInt = (msg.cheapestHour !== undefined && msg.cheapestHour !== null) ? parseInt(msg.cheapestHour) : -1;
var isCheapestHour = pricesOk && cheapestHourInt >= 0 && currentHourInt === cheapestHourInt && currentPrice <= avgPrice;

var chargeCriticalMax = avgPrice * 0.70;
if (!pricesOk) {
  isPriceLow = isNegPrice;   // without a price and an average only a negative price counts
} else if (batterySoC <= CFG.SOC_CRITICAL && currentPrice < avgPrice && currentPrice <= chargeCriticalMax) {
  isPriceLow = true;
} else if (inChargingWindow === null || inChargingWindow === undefined) {
  isPriceLow = isPriceVeryLow || isNegPrice;
} else {
  isPriceLow = inChargingWindow || isPriceVeryLow || isNegPrice || isCheapestHour;
}

var isPriceHigh;
if (!pricesOk) {
  isPriceHigh = false;
} else if (msg.inDischargeWindow === true) {
  isPriceHigh = currentPrice >= avgPrice && currentPrice >= dischargeAbsMin;
} else {
  isPriceHigh = priceRatio >= dischargeRatioThreshold && currentPrice >= dischargeAbsMin;
}

// Without a known SoC or without DSMR data the battery is not controlled at all
var batteryDataOk = socKnown && metersKnown;
var canCharge = batteryDataOk && batterySoC < CFG.SOC_MAX;
var canChargeSolar = batteryDataOk && batterySoC < CFG.SOC_MAX;
var canDischarge = batteryDataOk && batterySoC > CFG.SOC_MIN && batterySoC >= CFG.SOC_DISCHARGE_MIN;

var solarSurplusThreshold = lastState === 'charging' ? CFG.SOLAR_SURPLUS_EXIT_W : CFG.SOLAR_SURPLUS_W;
// A new state is applied on the second run that asks for it
var CONFIRM_CYCLES = 2;

var charging = false;
var discharging = false;
var targetAmps = 0;
var reason = '';

if (isNegPrice && canCharge) {
  var usableCapacity = CFG.BATTERY_KWH * ((CFG.SOC_MAX - CFG.SOC_MIN) / 100);
  var currentKwh = CFG.BATTERY_KWH * ((batterySoC - CFG.SOC_MIN) / 100);
  var kwhHeadroom = Math.max(0, usableCapacity - currentKwh);
  var targetKwPerHour = kwhHeadroom / negPriceHoursRemaining;
  var spreadAmps = Math.round((targetKwPerHour * 1000) / CFG.BATTERY_VOLTAGE / CFG.ROUND_TRIP_EFF);
  var homeLoadW = solarTotalW + rawNetGridW;
  var solarForBatteryW = Math.max(0, solarTotalW - homeLoadW);
  var solarOffsetAmps = Math.round(solarForBatteryW / CFG.BATTERY_VOLTAGE);
  var gridAmps = Math.max(0, spreadAmps - solarOffsetAmps);
  var negAmps = Math.min(maxAllowedChargeA, Math.max(CFG.MIN_CHARGE_A, spreadAmps));  // grid headroom always wins
  charging = true;
  targetAmps = negAmps;
  reason = 'Negative price (' + currentPrice.toFixed(3) + ' EUR/kWh) - charging at ' + targetAmps + ' A'
    + ' (' + negPriceHoursRemaining + ' neg-price hour(s) remaining,'
    + ' spreading ' + kwhHeadroom.toFixed(1) + ' kWh over window'
    + (solarOffsetAmps > 0 ? ', solar covers ~' + solarOffsetAmps + ' A, grid ~' + gridAmps + ' A' : '') + ')';

} else if (isPriceLow && canCharge) {
  var priceDiscount = 1 - priceRatio;
  var fraction = Math.max(0.10, Math.min(1.0, 0.50 + (priceDiscount * 2.5)));
  charging = true;
  if (batterySoC <= CFG.SOC_CRITICAL) {
    targetAmps = maxAllowedChargeA;
    reason = 'Critical SoC (' + batterySoC + '%) - charging at max ' + targetAmps + ' A (price ' + currentPrice.toFixed(3) + ' EUR below avg ' + avgPrice.toFixed(3) + ' EUR)';
  } else if (inChargingWindow) {
    // The planner sized this window for the full charge rate
    targetAmps = maxAllowedChargeA;
    reason = 'Planner: cheapest window (' + currentPrice.toFixed(3) + ' EUR) - charging at ' + targetAmps + ' A. Hours: ' + (msg.plannedChargeHours || []).join('h,') + 'h';
  } else {
    targetAmps = Math.round(maxAllowedChargeA * fraction);
    reason = 'Price override: ' + Math.round(priceRatio * 100) + '% of avg (' + currentPrice.toFixed(3) + ' EUR) below threshold - charging at ' + targetAmps + ' A outside planned window';
  }

} else if (actualSurplusW > solarSurplusThreshold && canChargeSolar && !msg.inDischargeWindow) {
  // AC surplus → DC amps: the battery receives less than the AC side delivers
  var surplusAmps = Math.floor((actualSurplusW * CFG.ROUND_TRIP_EFF) / CFG.BATTERY_VOLTAGE);
  charging = true;
  targetAmps = Math.min(CFG.MAX_AMPS, surplusAmps);
  reason = 'Solar surplus ' + actualSurplusW.toFixed(0) + ' W (' + solarTotalW.toFixed(0) + ' W produced) - absorbing at ' + targetAmps + ' A';

} else if (inSolarPreDischargeWindow && canDischarge && batterySoC > solarPreDischargeTargetSoC) {
  // Spread over the pre-discharge hours that are left (kWh / h = kW)
  var solarPreHoursCount = (msg.solarPreDischargeHours || []).length || 1;
  var solarPreAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS,
    Math.round(((kwhToFreeForSolar / solarPreHoursCount) * 1000) / CFG.BATTERY_VOLTAGE)
  ));
  discharging = true;
  targetAmps = solarPreAmps;
  reason = 'Solar pre-discharge: solar will fill battery before cheap window'
    + ' - discharging ' + targetAmps + ' A'
    + ' (target SoC ' + solarPreDischargeTargetSoC + '%'
    + ', freeing ' + kwhToFreeForSolar.toFixed(1) + ' kWh over ' + solarPreHoursCount + 'h for cheap grid charging)';

} else if (inPreDischargeWindow && canDischarge && batterySoC > preDischargeTargetSoC) {
  var preDischargeHoursCount = (msg.preDischargeHours || []).length || 1;
  // Only down to the level the negative window can refill (set by the planner)
  var kwhToDischarge = Math.max(0, CFG.BATTERY_KWH * ((batterySoC - preDischargeTargetSoC) / 100));
  var targetKwPD = kwhToDischarge / preDischargeHoursCount;
  var preAmps = Math.round((targetKwPD * 1000) / CFG.BATTERY_VOLTAGE);
  var clampedPreAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS, preAmps));
  discharging = true;
  targetAmps = clampedPreAmps;
  reason = 'Pre-discharge: neg price in ' + hoursUntilNegWindow + 'h (' + futureNegHoursCount + ' neg hour(s))'
    + ' - discharging ' + targetAmps + ' A to free ' + kwhToDischarge.toFixed(1) + ' kWh'
