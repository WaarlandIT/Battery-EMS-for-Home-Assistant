// EMS Decision Engine
// v3.90 - EV v2.19: fixes from full simulation review —
//          (1) battery state machine: amps computed for one direction could be
//              applied in the other during confirmation / forced idle (e.g.
//              discharging at charge amps for a cycle) and the idle step
//              between charge and discharge could be skipped; lastState is now
//              stored after confirmation and after the hard stop
//          (2) EV ramp: counter never reset after a step-up, so after the first
//              15 min the EV climbed 1A per poll; now max +1A per earned
//              window, counter resets on every step-up and does not accumulate
//              while no car is connected
//          (3) single-phase EV load (6A L1) is subtracted from the battery
//              discharge target and added back to L1 headroom
//          (4) headroom add-back only when EV current is actually flowing
//          (5) overload cut logic only runs when a car is connected
//          (6) negative-price minimum charge no longer overrides grid headroom
//          (7) Zaptec finished-early nudge limited to 3 attempts per episode
//              and skipped when ev_soc is unavailable
//          (8) l1HardOverload / l1WarnOverload exposed for the logger
// v3.89 - Bug fixes: evPhaseMode and evCanCharge now always set in all
//          branches of evSafeAmps determination — were undefined in the solar
//          surplus L1 fallback branch; dischargeTargetW corrected when EV not
//          charging (was subtracting 0, now clearly gridImport * 1000)
// v3.88 - Bug fixes: evLastAmps reset on disconnect; removed dead vars
// v3.87 - Cleanup: removed dead code (l1GraduatedCut, sixAmpResolves,
//          overloadTriggered, EV_L1_OVERLOAD_CYCLES, EV_MAX_AMPS,
//          EV_SOLAR_MIN_W, EV_SOLAR_EXIT_W); evJustFinished now has a
//          5-poll cooldown (~2.5 min) before nudging Zaptec again instead
//          of firing every cycle; session cut sends 5A (Zaptec minimum)
//          instead of 0A since Zaptec ignores 0A on the current entity
// v3.86 - EV v2.15: overload response based on current EV amps, not raw phase
//          threshold; phase > 20A with EV at 8A+ → drop to 6A L1 (soft cut);
//          phase > 20A with EV already at 6A → house caused overload → session
//          cut (0A); removes EV_L1_GRADUATED_LIMIT — no longer needed
// v3.85 - EV v2.14: graduated soft cut — phase load 20-22.5A drops to 8A
//          3-phase instead of jumping straight to 6A L1
// v3.84 - EV v2.13: force Zaptec write when connected_finished but evSoC < 100
// v3.83 - EV v2.12: evShouldWrite gated on evCarConnected
// v3.80 - EV v2.9: EV_RAMP_UP_POLLS raised 10 → 30 (~15 min at 30s polls)
// v3.79 - EV v2.8: phase headroom add-back; ramp-down lock
// v3.78 - EV v2.7: night discharge no longer caps EV
// v3.77 - EV v2.6: night discharge cap raised to 8A 3-phase
// v3.76 - Hard stop fix: batterySoC >= 97% forces dc_amps to 0
// v3.75 - (superseded)
// v3.74 - EV v2.5: daytime 3-phase up to 8A when isPriceVeryLow
// v3.73 - EV v2.4: EV_RAMP_UP_POLLS raised 4 → 10
// v3.72 - EV v2.3: daytime 3-phase ramp only at price <= 0
// v3.71 - EV v2.2: raw DSMR phase amps, no add-back
// v3.70 - EV v2.1: session cut only when house load alone >20A
// v3.69 - evCarFull sends 0A
// v3.68 - smarter overload response
// v3.65 - blackout window 17h-19h set to 5A

var EMS_VERSION = 'EMS v3.90';
var EV_VERSION  = 'EV v2.19';

var CFG = {
  MAX_AMPS:             100,
  BATTERY_VOLTAGE:      48,
  BATTERY_KWH:          40,
  SOC_MIN:              10,
  SOC_MAX:              95,
  SOC_DISCHARGE_MIN:    15,
  SOC_CRITICAL:         15,
  CHARGE_THRESHOLD:     0.80,
  DISCHARGE_THRESHOLD:  1.20,
  CHARGE_ABS_RATIO:     0.55,
  DISCHARGE_ABS_RATIO:  0.55,
  DISCHARGE_OVERSHOOT:  1.25,
  EXPORT_BIAS_W:        800,
  HYSTERESIS:           0.05,
  SOLAR_SURPLUS_W:      500,
  SOLAR_SURPLUS_EXIT_W: 200,
  ROUND_TRIP_EFF:       0.85,
  GRID_MAX_A_PHASE:     18,
  GRID_VOLTAGE:         230,
  SAFETY_MARGIN_A:      2,
  MIN_DISCHARGE_A:      35,
  MIN_CHARGE_A:         10,
  SOLAR_SUPPRESS_DISCHARGE_W: 500,
  EV_RATE_LIMIT_MS:     15 * 60 * 1000,
  EV_PUBLIC_RATE:       0.50
};

var currentPrice     = parseFloat(msg.currentPrice) || 0;
var avgPrice         = parseFloat(msg.avgPrice)     || 0.10;
var inChargingWindow = msg.inChargingWindow;

var gridImport       = parseFloat(msg.gridImport) || 0;
var gridExport       = parseFloat(msg.gridExport) || 0;

var zaptecMode    = msg.zaptecMode || '';
var lastEvAmps    = context.get('evLastAmps') || 0;
var evChargingW   = (msg.EVChargeLoad !== undefined && msg.EVChargeLoad !== null)
  ? parseFloat(msg.EVChargeLoad) || 0
  : lastEvAmps * CFG.GRID_VOLTAGE * 3;

var evSoCRaw      = parseFloat(msg.ev_soc);
var evSoCKnown    = !isNaN(evSoCRaw);
var evSoC         = evSoCKnown ? evSoCRaw : 0;
// ev_soc unavailable → trust Zaptec's connected_finished as full
var evCarFull     = (zaptecMode === 'connected_finished') && (!evSoCKnown || evSoC >= 100);

var evCarConnected = (
  zaptecMode === 'connected_charging'   ||
  zaptecMode === 'connected_finished'   ||
  zaptecMode === 'connected_requesting' ||
  zaptecMode === 'waiting'
);
var evDrawing      = zaptecMode === 'connected_charging' || evChargingW > 0;

var phaseL1kW  = parseFloat(msg.phaseL1)   || 0;
var phaseL2kW  = parseFloat(msg.phaseL2)   || 0;
var phaseL3kW  = parseFloat(msg.phaseL3)   || 0;
var pac1       = parseFloat(msg.pac1)       || 0;
var pac2       = parseFloat(msg.pac2)       || 0;
var pac3       = parseFloat(msg.pac3)       || 0;
var batterySoC = parseFloat(msg.batterySoC) || 50;

var rawNetGridW      = (gridImport - gridExport) * 1000 - evChargingW;
var netGridW         = Math.max(0, rawNetGridW);

var phaseL1A            = (phaseL1kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL2A            = (phaseL2kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL3A            = (phaseL3kW * 1000) / CFG.GRID_VOLTAGE;
var maxPhaseLoadA       = Math.max(phaseL1A, phaseL2A, phaseL3A);
var worstPhaseHeadroomA = Math.max(0, CFG.GRID_MAX_A_PHASE - maxPhaseLoadA - CFG.SAFETY_MARGIN_A);
var gridHeadroomW       = worstPhaseHeadroomA * CFG.GRID_VOLTAGE * 3;
var maxChargeFromGridA  = Math.round((gridHeadroomW / CFG.BATTERY_VOLTAGE) * CFG.ROUND_TRIP_EFF);
var maxAllowedChargeA   = Math.min(CFG.MAX_AMPS, maxChargeFromGridA);

var EV_3PHASE_MIN_A  = 7;

// EV draws on L1 in both modes; on L2/L3 only in 3-phase mode
var evL1Contrib      = lastEvAmps;
var evL23Contrib     = (lastEvAmps >= EV_3PHASE_MIN_A) ? lastEvAmps : 0;
var homeL1W          = Math.max(0, phaseL1A - evL1Contrib)  * CFG.GRID_VOLTAGE;
var homeL2W          = Math.max(0, phaseL2A - evL23Contrib) * CFG.GRID_VOLTAGE;
var homeL3W          = Math.max(0, phaseL3A - evL23Contrib) * CFG.GRID_VOLTAGE;
var homeImportW      = homeL1W + homeL2W + homeL3W;
var dischargeTargetW = evChargingW > 0
  ? Math.max(0, homeImportW)         // EV charging: use house-only import
  : Math.max(0, gridImport * 1000);  // no EV: full grid import is the target

var negPriceHoursRemaining       = parseInt(msg.negPriceHoursRemaining)       || 1;
var inPreDischargeWindow         = msg.inPreDischargeWindow === true;
var inSolarPreDischargeWindow    = msg.inSolarPreDischargeWindow === true;
var solarPreDischargeTargetSoC   = parseFloat(msg.solarPreDischargeTargetSoC) || 15;
var kwhToFreeForSolar            = parseFloat(msg.kwhToFreeForSolar)           || 0;
var hoursUntilNegWindow          = parseFloat(msg.hoursUntilNegWindow)         || 99;
var futureNegHoursCount          = parseInt(msg.futureNegHoursCount)           || 0;

var lastState    = context.get('lastState')    || 'idle';
var pendingState = context.get('pendingState') || 'idle';
var pendingCount = context.get('pendingCount') || 0;

var solarTotalW    = pac1 + pac2 + pac3;
var actualSurplusW = (rawNetGridW < 0 && solarTotalW > 50)
  ? Math.min(Math.abs(rawNetGridW), solarTotalW) : 0;

var priceRatio  = avgPrice > 0 ? currentPrice / avgPrice : 1;
var isNegPrice  = currentPrice < 0;

var chargeAbsMax    = avgPrice * CFG.CHARGE_ABS_RATIO;
var dischargeAbsMin = avgPrice * CFG.DISCHARGE_ABS_RATIO;

var dischargeRatioThreshold = lastState === 'discharging' ? CFG.DISCHARGE_THRESHOLD - CFG.HYSTERESIS : CFG.DISCHARGE_THRESHOLD;

var isPriceLow;
var isPriceVeryLow = priceRatio <= CFG.CHARGE_THRESHOLD && currentPrice <= chargeAbsMax;

var currentHourInt  = new Date().getHours();
var cheapestHourInt = (msg.cheapestHour !== undefined && msg.cheapestHour !== null) ? parseInt(msg.cheapestHour) : -1;
var isCheapestHour  = cheapestHourInt >= 0 && currentHourInt === cheapestHourInt && currentPrice <= avgPrice;

var chargeCriticalMax = avgPrice * 0.70;
if (batterySoC <= CFG.SOC_CRITICAL && currentPrice < avgPrice && currentPrice <= chargeCriticalMax) {
  isPriceLow = true;
} else if (inChargingWindow === null) {
  isPriceLow = isPriceVeryLow || isNegPrice;
} else {
  isPriceLow = inChargingWindow || isPriceVeryLow || isNegPrice || isCheapestHour;
}

var isPriceHigh;
if (msg.inDischargeWindow === true) {
  isPriceHigh = currentPrice >= avgPrice && currentPrice >= dischargeAbsMin;
} else {
  isPriceHigh = priceRatio >= dischargeRatioThreshold && currentPrice >= dischargeAbsMin;
}

var canCharge      = batterySoC < CFG.SOC_MAX;
var canChargeSolar = batterySoC < CFG.SOC_MAX;
var canDischarge   = batterySoC > CFG.SOC_MIN && batterySoC >= CFG.SOC_DISCHARGE_MIN;

var solarSurplusThreshold = lastState === 'charging' ? CFG.SOLAR_SURPLUS_EXIT_W : CFG.SOLAR_SURPLUS_W;
var CONFIRM_CYCLES = (isPriceLow || isPriceHigh || isNegPrice || (actualSurplusW > solarSurplusThreshold && canChargeSolar)) ? 1 : 2;

var charging    = false;
var discharging = false;
var targetAmps  = 0;
var reason      = '';

if (isNegPrice && canCharge) {
  var usableCapacity  = CFG.BATTERY_KWH * ((CFG.SOC_MAX - CFG.SOC_MIN) / 100);
  var currentKwh      = CFG.BATTERY_KWH * ((batterySoC - CFG.SOC_MIN) / 100);
  var kwhHeadroom     = Math.max(0, usableCapacity - currentKwh);
  var targetKwPerHour = kwhHeadroom / negPriceHoursRemaining;
  var spreadAmps      = Math.round((targetKwPerHour * 1000) / CFG.BATTERY_VOLTAGE / CFG.ROUND_TRIP_EFF);
  var homeLoadW        = solarTotalW + rawNetGridW;
  var solarForBatteryW = Math.max(0, solarTotalW - homeLoadW);
  var solarOffsetAmps  = Math.round(solarForBatteryW / CFG.BATTERY_VOLTAGE);
  var gridAmps         = Math.max(0, spreadAmps - solarOffsetAmps);
  var negAmps          = Math.min(maxAllowedChargeA, Math.max(CFG.MIN_CHARGE_A, spreadAmps));  // grid headroom always wins
  charging   = true;
  targetAmps = negAmps;
  reason     = 'Negative price (' + currentPrice.toFixed(3) + ' EUR/kWh) - charging at ' + targetAmps + ' A'
             + ' (' + negPriceHoursRemaining + ' neg-price hour(s) remaining,'
             + ' spreading ' + kwhHeadroom.toFixed(1) + ' kWh over window'
             + (solarOffsetAmps > 0 ? ', solar covers ~' + solarOffsetAmps + ' A, grid ~' + gridAmps + ' A' : '') + ')';

} else if (isPriceLow && canCharge) {
  var priceDiscount = 1 - priceRatio;
  var fraction      = Math.max(0.10, Math.min(1.0, 0.50 + (priceDiscount * 2.5)));
  charging = true;
  if (batterySoC <= CFG.SOC_CRITICAL) {
    targetAmps = maxAllowedChargeA;
    reason     = 'Critical SoC (' + batterySoC + '%) - charging at max ' + targetAmps + ' A (price ' + currentPrice.toFixed(3) + ' EUR below avg ' + avgPrice.toFixed(3) + ' EUR)';
  } else if (inChargingWindow) {
    targetAmps = Math.round(maxAllowedChargeA * fraction);
    reason     = 'Planner: cheapest window (' + currentPrice.toFixed(3) + ' EUR) - charging at ' + targetAmps + ' A. Hours: ' + (msg.plannedChargeHours || []).join('h,') + 'h';
  } else {
    targetAmps = Math.round(maxAllowedChargeA * fraction);
    reason     = 'Price override: ' + Math.round(priceRatio * 100) + '% of avg (' + currentPrice.toFixed(3) + ' EUR) below threshold - charging at ' + targetAmps + ' A outside planned window';
  }

} else if (actualSurplusW > solarSurplusThreshold && canChargeSolar && !msg.inDischargeWindow) {
  var surplusAmps = Math.round((actualSurplusW / CFG.BATTERY_VOLTAGE) / CFG.ROUND_TRIP_EFF);
  charging   = true;
  targetAmps = Math.min(CFG.MAX_AMPS, surplusAmps);
  reason     = 'Solar surplus ' + actualSurplusW.toFixed(0) + ' W (' + solarTotalW.toFixed(0) + ' W produced) - absorbing at ' + targetAmps + ' A';

} else if (inSolarPreDischargeWindow && canDischarge && batterySoC > solarPreDischargeTargetSoC) {
  var solarPreAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS,
    Math.round((kwhToFreeForSolar * 1000) / CFG.BATTERY_VOLTAGE)
  ));
  discharging = true;
  targetAmps  = solarPreAmps;
  reason      = 'Solar pre-discharge: solar will fill battery before cheap window'
              + ' - discharging ' + targetAmps + ' A'
              + ' (target SoC ' + solarPreDischargeTargetSoC + '%'
              + ', freeing ' + kwhToFreeForSolar.toFixed(1) + ' kWh for cheap grid charging)';

} else if (inPreDischargeWindow && canDischarge) {
  var preDischargeHoursCount = (msg.preDischargeHours || []).length || 1;
  var currentKwhPD   = CFG.BATTERY_KWH * ((batterySoC - CFG.SOC_MIN) / 100);
  var minKwhPD       = CFG.BATTERY_KWH * ((CFG.SOC_DISCHARGE_MIN - CFG.SOC_MIN) / 100);
  var kwhToDischarge = Math.max(0, currentKwhPD - minKwhPD);
  var targetKwPD     = kwhToDischarge / preDischargeHoursCount;
  var preAmps        = Math.round((targetKwPD * 1000) / CFG.BATTERY_VOLTAGE);
  var clampedPreAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS, preAmps));
  discharging = true;
  targetAmps  = clampedPreAmps;
  reason      = 'Pre-discharge: neg price in ' + hoursUntilNegWindow + 'h (' + futureNegHoursCount + ' neg hour(s))'
              + ' - discharging ' + targetAmps + ' A to free ' + kwhToDischarge.toFixed(1) + ' kWh'
              + ' over ' + preDischargeHoursCount + 'h (SoC ' + batterySoC + '% → ' + CFG.SOC_DISCHARGE_MIN + '%)';

} else if (isPriceHigh && canDischarge) {
  if (dischargeTargetW > 0) {
    var evIsCharging = evChargingW > 0 || lastEvAmps > 0;
    var exportBias   = (solarTotalW > 500 || evIsCharging) ? 0 : CFG.EXPORT_BIAS_W;
    var targetW      = dischargeTargetW + exportBias;
    var neededAmps   = Math.round((targetW / CFG.BATTERY_VOLTAGE) * CFG.DISCHARGE_OVERSHOOT);
    var clampedAmps  = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS, neededAmps));
    discharging = true;
    targetAmps  = clampedAmps;
    reason      = 'High price (' + (priceRatio * 100).toFixed(0) + '% of avg, ' + currentPrice.toFixed(3) + ' EUR) - discharging ' + targetAmps + ' A to cover ' + dischargeTargetW.toFixed(0) + ' W gross import' + (exportBias > 0 ? ' + ' + exportBias + ' W export bias' : ' (no bias, solar active)') + (neededAmps < CFG.MIN_DISCHARGE_A ? ' (raised to minimum ' + CFG.MIN_DISCHARGE_A + ' A)' : '');
  } else if (actualSurplusW > 0) {
    var importOnlyW = Math.max(0, gridImport * 1000 - evChargingW);
    if (importOnlyW > 0) {
      var throttleAmps = Math.round((importOnlyW / CFG.BATTERY_VOLTAGE) * CFG.DISCHARGE_OVERSHOOT);
      throttleAmps = Math.max(CFG.MIN_DISCHARGE_A, Math.min(CFG.MAX_AMPS, throttleAmps));
      discharging = true;
      targetAmps  = throttleAmps;
      reason      = 'High price (' + (priceRatio * 100).toFixed(0) + '% of avg, ' + currentPrice.toFixed(3) + ' EUR) - throttled discharge ' + targetAmps + ' A (solar exporting ' + actualSurplusW.toFixed(0) + ' W, covering ' + importOnlyW.toFixed(0) + ' W import only)';
    } else {
      discharging = false;
      targetAmps  = 0;
      reason      = 'High price (' + (priceRatio * 100).toFixed(0) + '% of avg, ' + currentPrice.toFixed(3) + ' EUR) - solar covers all load (' + actualSurplusW.toFixed(0) + ' W surplus), battery idle';
    }
  } else {
    discharging = true;
    targetAmps  = CFG.MIN_DISCHARGE_A;
    reason      = 'High price (' + (priceRatio * 100).toFixed(0) + '% of avg, ' + currentPrice.toFixed(3) + ' EUR) - exporting ' + CFG.MIN_DISCHARGE_A + ' A to grid at peak price';
  }

} else {
  reason = 'Idle - SoC ' + batterySoC + '%, price ' + currentPrice.toFixed(3) + ' EUR (' + (priceRatio * 100).toFixed(0) + '% of avg), solar ' + solarTotalW.toFixed(0) + ' W, netGrid ' + netGridW.toFixed(0) + ' W | ' + (msg.plannerReason || 'no planner');
}

if (charging && discharging) { discharging = false; reason += ' [conflict resolved: charge wins]'; }
if (targetAmps === 0) { charging = false; discharging = false; }

// State this cycle's decision branch computed targetAmps for
var decidedState = charging ? 'charging' : discharging ? 'discharging' : 'idle';
var rawState = decidedState;
if (rawState === 'discharging' && lastState === 'charging') { rawState = 'idle'; reason += ' [forced idle: charge → idle → discharge]'; }
if (rawState === 'charging'    && lastState === 'discharging') { rawState = 'idle'; reason += ' [forced idle: discharge → idle → charge]'; }

var confirmedState;
if (rawState === pendingState) {
  var newCount = pendingCount + 1;
  context.set('pendingCount', newCount);
  if (newCount >= CONFIRM_CYCLES) {
    confirmedState = rawState;
  } else {
    confirmedState = lastState;
    reason += ' [confirming ' + newCount + '/' + CONFIRM_CYCLES + ']';
  }
} else {
  context.set('pendingState', rawState);
  context.set('pendingCount', 1);
  confirmedState = lastState;
  reason += ' [pending change to ' + rawState + ' 1/' + CONFIRM_CYCLES + ']';
}

// Only apply targetAmps when the confirmed state is the one they were computed
// for. While confirming or during a forced-idle transition, hold idle — never
// apply charge amps as discharge amps or vice versa.
if (confirmedState !== decidedState) { confirmedState = 'idle'; }
charging    = confirmedState === 'charging';
discharging = confirmedState === 'discharging';
targetAmps  = (charging || discharging) ? targetAmps : 0;
if (targetAmps === 0) { charging = false; discharging = false; }

var dc_amps  = charging    ? targetAmps : 0;
var dc_power = discharging ? targetAmps * CFG.BATTERY_VOLTAGE : 0;

// ── Hard stop — enforced just before output ───────────────────────────────────
// If SoC >= 97% force dc_amps to 0 regardless of what any branch decided.
if (batterySoC >= 97) {
  dc_amps    = 0;
  charging   = false;
  reason     = 'HARD STOP: SoC ' + batterySoC + '% >= 97% — charging blocked to protect battery';
}

// Persist the state actually sent to the inverter (after confirmation + hard stop)
context.set('lastState', charging ? 'charging' : discharging ? 'discharging' : 'idle');

msg.payload = {
  version:     EMS_VERSION + ' / Planner ' + (msg.plannerVersion || 'unknown'),
  dc_amps:     dc_amps,
  dc_power:    dc_power,
  charging:    charging,
  discharging: discharging,
  reason:      reason,
  planner: {
    inWindow:              msg.inChargingWindow,
    inDischargeWindow:     msg.inDischargeWindow,
    dischargeThreshold:    msg.dischargeThreshold || null,
    hoursNeeded:           msg.hoursNeeded,
    kwhNeeded:             msg.kwhNeeded,
    cheapestPrice:         msg.cheapestPrice,
    plannedHours:          msg.plannedChargeHours,
    plannedDischargeHours: msg.plannedDischargeHours,
    reason:                msg.plannerReason
  },
  inputs: {
    currentPrice:        currentPrice,
    avgPrice:            avgPrice,
    priceRatio:          parseFloat((priceRatio * 100).toFixed(1)),
    chargeAbsMax:        parseFloat(chargeAbsMax.toFixed(3)),
    dischargeAbsMin:     parseFloat(dischargeAbsMin.toFixed(3)),
    lastState:           lastState,
    batterySoC:          batterySoC,
    solarTotal_W:        solarTotalW,
    netGrid_W:           netGridW,
    dischargeTarget_W:   dischargeTargetW,
    actualSurplus_W:     actualSurplusW,
    phaseL1_A:           parseFloat(phaseL1A.toFixed(2)),
    phaseL2_A:           parseFloat(phaseL2A.toFixed(2)),
    phaseL3_A:           parseFloat(phaseL3A.toFixed(2)),
    maxPhaseLoad_A:      parseFloat(maxPhaseLoadA.toFixed(2)),
    worstHeadroom_A:     parseFloat(worstPhaseHeadroomA.toFixed(2)),
    gridHeadroom_W:      parseFloat(gridHeadroomW.toFixed(0)),
    maxAllowedCharge_A:  maxAllowedChargeA,
    evCharging_W:        evChargingW,
    evLastAmps:          lastEvAmps,
    evSensorUsed:        (msg.EVChargeLoad !== undefined && msg.EVChargeLoad !== null)
  },
  timestamp: new Date().toISOString()
};

node.status({
  fill:  batterySoC >= 97 ? 'yellow' : charging ? 'green' : discharging ? 'red' : 'grey',
  shape: 'dot',
  text:  batterySoC >= 97 ? 'HARD STOP SoC:' + batterySoC + '%' : EMS_VERSION + ' ' + (charging ? 'CHG ' : discharging ? 'DCH ' : 'IDLE ') + targetAmps + 'A | SoC:' + batterySoC + '% | ' + currentPrice.toFixed(3) + 'EUR | solar:' + solarTotalW.toFixed(0) + 'W'
});

// ── EV Charge Controller v2.19 ────────────────────────────────────────────────
//
// v2.17–v2.19 changes: see file header. Changes in v2.16 (vs v2.15):
//
// 1. Dead code removed: l1GraduatedCut, sixAmpResolves, overloadTriggered,
//    EV_L1_OVERLOAD_CYCLES, EV_MAX_AMPS, EV_SOLAR_MIN_W, EV_SOLAR_EXIT_W
//
// 2. evJustFinished has a 5-poll cooldown (~2.5 min) before nudging Zaptec
//    again instead of firing every cycle — prevents harassing Zaptec into
//    dropping a legitimately finished session
//
// 3. Session cut sends 5A (Zaptec minimum) instead of 0A — Zaptec ignores
//    0A on the current entity; use the switch node for a true pause

var currentHour = new Date().getHours();
var currentMin  = new Date().getMinutes();

// ── Time windows ──────────────────────────────────────────────────────────────
var EV_BLACKOUT_START  = 17;
var EV_BLACKOUT_END    = 19;
var EV_NIGHT_START     = 22;
var EV_NIGHT_START_MIN = 30;
var EV_NIGHT_END       = 7;
var evInBlackout = currentHour >= EV_BLACKOUT_START && currentHour < EV_BLACKOUT_END;
var evInNight    = (currentHour > EV_NIGHT_START || (currentHour === EV_NIGHT_START && currentMin >= EV_NIGHT_START_MIN))
                 || currentHour < EV_NIGHT_END;

// ── EV constants ──────────────────────────────────────────────────────────────
var EV_MIN_AMPS           = 6;
var EV_NIGHT_MAX          = 12;
var EV_NIGHT_MIN          = 8;
var EV_L1_HARD_LIMIT      = 20;
var EV_L1_WARN_LIMIT      = 18;
var EV_CUT_COOLDOWN_POLLS = 10;
var EV_RAMP_UP_POLLS      = 30;   // ~15 min at 30s polls per 1A step
var EV_FINISHED_COOLDOWN  = 5;    // polls between Zaptec nudges when connected_finished early
var EV_FINISHED_MAX_NUDGES = 3;   // stop nudging after this — car may have its own charge limit

// ── Retrieve EV persistent state ─────────────────────────────────────────────
var evCutCooldown      = context.get('evCutCooldown')      || 0;
var evRampClearCount   = context.get('evRampClearCount')   || 0;
var l1OverloadCount    = context.get('l1OverloadCount')    || 0;
var evFinishedCooldown = context.get('evFinishedCooldown') || 0;

// ── Battery charge hold-down ──────────────────────────────────────────────────
var EV_CHARGE_HOLDDOWN_CYCLES = 4;
var wasCharging   = context.get('battWasCharging') || false;
var holdDownCount = context.get('evHoldDownCount') || 0;
if (charging) {
  holdDownCount = 0;
} else if (wasCharging && !charging) {
  holdDownCount = 1;
} else if (holdDownCount > 0 && holdDownCount < EV_CHARGE_HOLDDOWN_CYCLES) {
  holdDownCount++;
} else {
  holdDownCount = 0;
}
context.set('battWasCharging', charging);
context.set('evHoldDownCount', holdDownCount);
var evInHoldDown = holdDownCount > 0;

// ── Phase loads — raw DSMR, no add-back ──────────────────────────────────────
var evCurrentPerPhase = lastEvAmps;
var evIn3Phase   = lastEvAmps >= EV_3PHASE_MIN_A;
var phaseL1LoadA = (phaseL1kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL2LoadA = (phaseL2kW * 1000) / CFG.GRID_VOLTAGE;
var phaseL3LoadA = (phaseL3kW * 1000) / CFG.GRID_VOLTAGE;

// ── Overload detection ────────────────────────────────────────────────────────
// Response based on current EV amps:
//   phase > 20A AND EV at 8A+ → soft cut: drop to 6A L1, keep session alive
//   phase > 20A AND EV at 6A  → house caused overload → session cut: 5A
var maxPhaseLoad = Math.max(phaseL1LoadA, phaseL2LoadA, phaseL3LoadA);
var anyOver20    = maxPhaseLoad > EV_L1_HARD_LIMIT;
var l1SoftCut    = evCarConnected && anyOver20 && lastEvAmps > EV_MIN_AMPS;
var l1SessionCut = evCarConnected && anyOver20 && lastEvAmps <= EV_MIN_AMPS;

var anyWarnOverload = !anyOver20 && (
                      phaseL1LoadA > EV_L1_WARN_LIMIT ||
                      phaseL2LoadA > EV_L1_WARN_LIMIT ||
                      phaseL3LoadA > EV_L1_WARN_LIMIT);
if (anyWarnOverload) { l1OverloadCount++; } else { l1OverloadCount = 0; }
context.set('l1OverloadCount', l1OverloadCount);

// ── Post-cut cooldown and ramp counter update ─────────────────────────────────
var inCutCooldown = evCutCooldown > 0;

if (l1SessionCut) {
  evCutCooldown    = EV_CUT_COOLDOWN_POLLS;
  evRampClearCount = 0;
} else if (inCutCooldown) {
  evCutCooldown--;
  evRampClearCount = 0;
} else if (l1SoftCut || !evCarConnected) {
  evRampClearCount = 0;   // also: no accumulation while no car is connected
} else {
  evRampClearCount++;
}
context.set('evCutCooldown',    evCutCooldown);
context.set('evRampClearCount', evRampClearCount);

// ── Phase headroom ─────────────────────────────────────────────────────────────
// Add back EV's own per-phase contribution so headroom reflects house load only.
// Only credit EV current that is actually flowing — crediting lastEvAmps while
// the EV is paused/finished overstates headroom and can overload on resume.
var evAddBackL1  = evDrawing ? lastEvAmps : 0;                  // EV is on L1 in both modes
var evAddBackL23 = (evDrawing && evIn3Phase) ? lastEvAmps : 0;  // L2/L3 only in 3-phase
var l1HeadroomA  = Math.max(0, EV_L1_HARD_LIMIT - phaseL1LoadA + evAddBackL1);
var l2HeadroomA  = Math.max(0, EV_L1_HARD_LIMIT - phaseL2LoadA + evAddBackL23);
var l3HeadroomA  = Math.max(0, EV_L1_HARD_LIMIT - phaseL3LoadA + evAddBackL23);
var worst3PhaseA = Math.min(l1HeadroomA, l2HeadroomA, l3HeadroomA);

// ── Phase mode hysteresis ─────────────────────────────────────────────────────
var EV_PHASE_DROP_CYCLES = 3;
var phaseDropCount = context.get('phaseDropCount') || 0;
if (worst3PhaseA < EV_3PHASE_MIN_A) {
  phaseDropCount = Math.min(phaseDropCount + 1, EV_PHASE_DROP_CYCLES + 1);
} else {
  phaseDropCount = 0;
}
context.set('phaseDropCount', phaseDropCount);
var allow3Phase = evInNight
  ? true
  : (worst3PhaseA >= EV_3PHASE_MIN_A) || (phaseDropCount < EV_PHASE_DROP_CYCLES);

// ── Solar surplus for EV ──────────────────────────────────────────────────────
var SOLAR_EV_MARGIN_W     = 200;
var gridExportW           = Math.max(0, (gridExport - gridImport) * 1000);
var solarSurplusPerPhaseA = Math.floor((gridExportW - SOLAR_EV_MARGIN_W) / CFG.GRID_VOLTAGE / 3);
var solarSurplusL1A       = Math.floor((gridExportW - SOLAR_EV_MARGIN_W) / CFG.GRID_VOLTAGE);
var hasSolarSurplus       = gridExportW > SOLAR_EV_MARGIN_W;

// ── Determine evSafeAmps and evPhaseMode ─────────────────────────────────────
var evSafeAmps;
var evPhaseMode;
var evCanCharge;

if (l1SessionCut || inCutCooldown) {
  // House load caused overload — set to Zaptec minimum (5A) to keep session alive
  // but signal via switch node to actually pause charging
  evSafeAmps  = 5;
  evPhaseMode = 'single-phase-L1';
  evCanCharge = false;

} else if (l1SoftCut) {
  // EV at 8A+ caused overload — drop to 6A L1, keep session alive
  evSafeAmps  = EV_MIN_AMPS;
  evPhaseMode = 'single-phase-L1';
  evCanCharge = true;

} else if (allow3Phase) {
  var maxAllowed;
  if (evInNight) {
    var rampBase  = Math.max(EV_MIN_AMPS, lastEvAmps);
    var rampBonus = evRampClearCount >= EV_RAMP_UP_POLLS ? 1 : 0;   // max +1A per earned window
    maxAllowed    = Math.min(EV_NIGHT_MAX, rampBase + rampBonus);
  } else if (charging || evInHoldDown) {
    maxAllowed = EV_MIN_AMPS;
  } else if (!charging && currentPrice <= 0) {
    var rampBase2  = Math.max(EV_MIN_AMPS, lastEvAmps);
    var rampBonus2 = evRampClearCount >= EV_RAMP_UP_POLLS ? 1 : 0;
    maxAllowed     = Math.min(EV_NIGHT_MAX, rampBase2 + rampBonus2);
  } else if (!charging && isPriceVeryLow) {
    var rampBase3  = Math.max(EV_MIN_AMPS, lastEvAmps);
    var rampBonus3 = evRampClearCount >= EV_RAMP_UP_POLLS ? 1 : 0;
    maxAllowed     = Math.min(8, rampBase3 + rampBonus3);
  } else if (hasSolarSurplus && solarSurplusPerPhaseA >= EV_3PHASE_MIN_A) {
    maxAllowed = Math.min(16, solarSurplusPerPhaseA + evCurrentPerPhase);
  } else {
    maxAllowed = EV_MIN_AMPS;
  }

  var candidate3 = Math.min(maxAllowed, Math.floor(worst3PhaseA));
  if (candidate3 >= EV_3PHASE_MIN_A) {
    evSafeAmps  = candidate3;
    evPhaseMode = '3-phase';
  } else {
    evSafeAmps  = EV_MIN_AMPS;
    evPhaseMode = 'single-phase-L1';
  }
  evCanCharge = true;

  if (evInNight && evSafeAmps < EV_NIGHT_MIN) {
    evSafeAmps  = EV_NIGHT_MIN;
    evPhaseMode = '3-phase';
  }

} else {
  if (hasSolarSurplus && solarSurplusL1A + evCurrentPerPhase > EV_MIN_AMPS && !evInNight) {
    evSafeAmps  = Math.min(EV_3PHASE_MIN_A - 1, solarSurplusL1A + evCurrentPerPhase);
    evSafeAmps  = Math.max(EV_MIN_AMPS, evSafeAmps);
    evPhaseMode = 'single-phase-L1';  // no 3-phase headroom — solar on L1 only
    evCanCharge = true;
  } else if (evInNight) {
    evSafeAmps  = EV_NIGHT_MIN;
    evPhaseMode = '3-phase';
    evCanCharge = true;
  } else {
    evSafeAmps  = EV_MIN_AMPS;
    evPhaseMode = 'single-phase-L1';
    evCanCharge = true;
  }
}

// ── Ramp-down lock ────────────────────────────────────────────────────────────
if (evSafeAmps < lastEvAmps) {
  evRampClearCount = 0;
  context.set('evRampClearCount', evRampClearCount);
}

// ── Car connected? ────────────────────────────────────────────────────────────
var evLastWriteTime = context.get('evLastWriteTime') || 0;
var evTimeSince     = new Date().getTime() - evLastWriteTime;

// evCarConnected / evDrawing are defined at the top of the script

// ── EV Decision ───────────────────────────────────────────────────────────────
var evTargetAmps = 0;
var evReason     = '';

if (!evCarConnected) {
  evTargetAmps = 0;
  evReason     = 'Car not connected (' + (zaptecMode || 'unknown') + ')';

} else if (evCarFull) {
  evTargetAmps = 0;
  evPhaseMode  = 'single-phase-L1';
  evReason     = 'Car full (SoC ' + evSoC + '%) — 0A, Zaptec manages session';

} else if (l1SessionCut) {
  evTargetAmps     = 5;
  evPhaseMode      = 'single-phase-L1';
  evCutCooldown    = EV_CUT_COOLDOWN_POLLS;
  evRampClearCount = 0;
  context.set('evCutCooldown',    evCutCooldown);
  context.set('evRampClearCount', evRampClearCount);
  evReason = 'Phase overload (' + maxPhaseLoad.toFixed(1)
           + 'A > 20A) — EV at 6A, house caused overload — EV to min 5A, cooldown ' + EV_CUT_COOLDOWN_POLLS + ' polls';

} else if (inCutCooldown) {
  evTargetAmps = 5;
  evPhaseMode  = 'single-phase-L1';
  evReason     = 'Post-cut cooldown (' + evCutCooldown + ' polls remaining) — EV at min 5A';

} else if (l1SoftCut) {
  evTargetAmps = EV_MIN_AMPS;
  evPhaseMode  = 'single-phase-L1';
  evReason     = 'Phase overload (' + maxPhaseLoad.toFixed(1)
               + 'A > 20A) — EV at ' + lastEvAmps + 'A caused it — dropped to 6A [L1], session kept alive';

} else if (evInBlackout) {
  evTargetAmps = 5;
  evPhaseMode  = 'single-phase-L1';
  evReason     = 'Blackout window ' + EV_BLACKOUT_START + 'h-' + EV_BLACKOUT_END + 'h (cooking peak) - 5A session kept alive [L1]';

} else {
  if (discharging && !evInNight) {
    evTargetAmps = EV_MIN_AMPS;
    evPhaseMode  = 'single-phase-L1';
  } else if (charging && evInNight) {
    evTargetAmps = Math.min(8, evSafeAmps);
    evPhaseMode  = '3-phase';
  } else {
    evTargetAmps = evSafeAmps;
  }

  if (evInNight && evPhaseMode === '3-phase') {
    evReason = 'Night charging (' + currentPrice.toFixed(3) + ' EUR) - ' + evTargetAmps + 'A [3-phase, max ' + EV_NIGHT_MAX + 'A]'
             + ' ramp=' + evRampClearCount + '/' + EV_RAMP_UP_POLLS
             + ' (headroom: L1=' + l1HeadroomA.toFixed(0) + ' L2=' + l2HeadroomA.toFixed(0) + ' L3=' + l3HeadroomA.toFixed(0) + ')';
  } else if (evPhaseMode === '3-phase') {
    evReason = 'Charging ' + evTargetAmps + 'A [3-phase] (headroom: worst=' + Math.floor(worst3PhaseA) + 'A)';
  } else {
    evReason = 'Charging ' + evTargetAmps + 'A [L1 single-phase] (L1 headroom: ' + l1HeadroomA.toFixed(0) + 'A)';
  }

  if (discharging && !evInNight) {
    evReason += ' — battery discharging, capped at 6A baseline';
  } else if (charging && evInNight) {
    evReason += ' — battery charging, night cap 8A 3-phase';
  } else if (inChargingWindow && currentPrice <= chargeAbsMax) {
    evReason += ' — cheap price window (' + currentPrice.toFixed(3) + ' EUR)';
  } else if (isPriceVeryLow) {
    evReason += ' — price override (' + currentPrice.toFixed(3) + ' EUR, ' + Math.round(priceRatio * 100) + '% of avg)';
  } else if (hasSolarSurplus) {
    evReason += ' — solar surplus ' + gridExportW.toFixed(0) + 'W exported (' + currentPrice.toFixed(3) + ' EUR)';
  } else {
    evReason += ' — baseline (' + currentPrice.toFixed(3) + ' EUR)';
  }
}

// ── Step-up lock ──────────────────────────────────────────────────────────────
// Every 1A increase must be earned with a fresh EV_RAMP_UP_POLLS window (~15 min)
if (evCarConnected && evTargetAmps > lastEvAmps) {
  evRampClearCount = 0;
  context.set('evRampClearCount', evRampClearCount);
}

// ── EV Session accumulator ────────────────────────────────────────────────────
var evLastCycleTime = context.get('evLastCycleTime') || 0;
var evNowMs         = new Date().getTime();
var evCycleSeconds  = evLastCycleTime > 0 ? (evNowMs - evLastCycleTime) / 1000 : 0;
context.set('evLastCycleTime', evNowMs);

var evWasConnected = context.get('evWasConnected') || false;
if (!evCarConnected && evWasConnected) {
  context.set('evSessionKwh',       0);
  context.set('evSessionCostAct',   0);
  context.set('evSessionCostPub',   0);
  context.set('evCutCooldown',      0);
  context.set('evRampClearCount',   0);
  context.set('evFinishedCooldown', 0);
  context.set('evLastAmps',         0);  // reset so first write on new session always fires
}
context.set('evWasConnected', evCarConnected);

var evSessionKwh     = context.get('evSessionKwh')     || 0;
var evSessionCostAct = context.get('evSessionCostAct') || 0;
var evSessionCostPub = context.get('evSessionCostPub') || 0;

var evChargingNowW = parseFloat(msg.EVChargeLoad) || 0;
if (evCarConnected && evChargingNowW > 0 && evCycleSeconds > 0 && evCycleSeconds < 300) {
  var evCycleKwh    = (evChargingNowW / 1000) * (evCycleSeconds / 3600);
  evSessionKwh     += evCycleKwh;
  evSessionCostAct += evCycleKwh * currentPrice;
  evSessionCostPub += evCycleKwh * CFG.EV_PUBLIC_RATE;
  context.set('evSessionKwh',     evSessionKwh);
  context.set('evSessionCostAct', evSessionCostAct);
  context.set('evSessionCostPub', evSessionCostPub);
}

var evInstantKw      = evChargingNowW / 1000;
var evInstantCostAct = evInstantKw * currentPrice;
var evInstantCostPub = evInstantKw * CFG.EV_PUBLIC_RATE;
var evInstantSaving  = evInstantCostPub - evInstantCostAct;
var evSessionSaving  = evSessionCostPub - evSessionCostAct;

// ── Rate limit ────────────────────────────────────────────────────────────────
// evJustFinished: Zaptec in connected_finished but car not full.
// Uses a cooldown (EV_FINISHED_COOLDOWN polls) to avoid hammering the API —
// nudges Zaptec every ~2.5 min instead of every 30s.
var evJustFinished = false;
var evFinishedNudges = context.get('evFinishedNudges') || 0;
if (evCarConnected && zaptecMode === 'connected_finished' && evSoCKnown && evSoC < 100) {
  if (evFinishedNudges < EV_FINISHED_MAX_NUDGES && evFinishedCooldown <= 0) {
    evJustFinished = true;
    evFinishedNudges++;
    evFinishedCooldown = EV_FINISHED_COOLDOWN;
  } else if (evFinishedCooldown > 0) {
    evFinishedCooldown--;
  }
} else {
  evFinishedCooldown = 0;
  evFinishedNudges   = 0;   // reset once Zaptec leaves connected_finished
}
context.set('evFinishedCooldown', evFinishedCooldown);
context.set('evFinishedNudges',   evFinishedNudges);

var evShouldWrite       = (evTargetAmps !== lastEvAmps) || (evTimeSince >= CFG.EV_RATE_LIMIT_MS) || evJustFinished;
var evShouldWriteZaptec = evCarConnected && evShouldWrite;
if (evShouldWrite) {
  context.set('evLastWriteTime', new Date().getTime());
  context.set('evLastAmps', evTargetAmps);
}

// ── Build EV output message ───────────────────────────────────────────────────
var evCharging = evTargetAmps > 0;

var evMsg = {
  payload: {
    version:      EV_VERSION,
    targetAmps:   parseFloat(evTargetAmps),
    evCharging:   evCharging,
    carConnected: evCarConnected,
    reason:       evReason,
    shouldWrite:  evShouldWriteZaptec,
    inputs: {
      zaptecMode:            zaptecMode,
      currentPrice:          currentPrice,
      avgPrice:              avgPrice,
      surplus_W:             actualSurplusW,
      lastEvAmps:            lastEvAmps,
      cheapestHour:          msg.cheapestHour,
      cheapestPrice:         msg.cheapestPrice,
      currentHour:           currentHour,
      evInBlackout:          evInBlackout,
      evInNight:             evInNight,
      evPhaseMode:           evPhaseMode,
      evSafeAmps:            evSafeAmps,
      evCanCharge:           evCanCharge,
      phaseL1LoadA:          parseFloat(phaseL1LoadA.toFixed(2)),
      phaseL2LoadA:          parseFloat(phaseL2LoadA.toFixed(2)),
      phaseL3LoadA:          parseFloat(phaseL3LoadA.toFixed(2)),
      anyOver20:             anyOver20,
      l1HardOverload:        anyOver20,
      l1WarnOverload:        anyWarnOverload,
      evDrawing:             evDrawing,
      l1HeadroomA:           parseFloat(l1HeadroomA.toFixed(1)),
      l2HeadroomA:           parseFloat(l2HeadroomA.toFixed(1)),
      l3HeadroomA:           parseFloat(l3HeadroomA.toFixed(1)),
      worst3PhaseA:          parseFloat(worst3PhaseA.toFixed(1)),
      l1OverloadCount:       l1OverloadCount,
      l1SessionCut:          l1SessionCut,
      l1SoftCut:             l1SoftCut,
      inCutCooldown:         inCutCooldown,
      evCutCooldown:         evCutCooldown,
      evRampClearCount:      evRampClearCount,
      evJustFinished:        evJustFinished,
      evFinishedCooldown:    evFinishedCooldown,
      evFinishedNudges:      evFinishedNudges,
      evInHoldDown:          evInHoldDown,
      holdDownCount:         holdDownCount,
      phaseDropCount:        phaseDropCount,
      allow3Phase:           allow3Phase,
      gridExportW:           parseFloat(gridExportW.toFixed(0)),
      solarSurplusPerPhaseA: solarSurplusPerPhaseA,
      hasSolarSurplus:       hasSolarSurplus,
      timeSince_s:           Math.round(evTimeSince / 1000)
    },
    session: {
      kwh:            parseFloat(evSessionKwh.toFixed(3)),
      costActual:     parseFloat(evSessionCostAct.toFixed(4)),
      costPublic:     parseFloat(evSessionCostPub.toFixed(4)),
      saving:         parseFloat(evSessionSaving.toFixed(4)),
      instantKw:      parseFloat(evInstantKw.toFixed(3)),
      instantCostAct: parseFloat(evInstantCostAct.toFixed(4)),
      instantCostPub: parseFloat(evInstantCostPub.toFixed(4)),
      instantSaving:  parseFloat(evInstantSaving.toFixed(4))
    }
  },
  evTargetAmps:     evTargetAmps,
  evCharging:       evCharging,
  evShouldWrite:    evShouldWriteZaptec,
  zaptecValue:      parseFloat(evTargetAmps),
  evSessionKwh:     parseFloat(evSessionKwh.toFixed(3)),
  evSessionCostAct: parseFloat(evSessionCostAct.toFixed(4)),
  evSessionCostPub: parseFloat(evSessionCostPub.toFixed(4)),
  evSessionSaving:  parseFloat(evSessionSaving.toFixed(4)),
  evInstantCostAct: parseFloat(evInstantCostAct.toFixed(4)),
  evInstantCostPub: parseFloat(evInstantCostPub.toFixed(4))
};

return [ msg, evMsg ];
