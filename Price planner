// Price Planner
// v2.16 - fixes from the second code review —
//          (1) charge window is planned over the current price valley: from now
//              until the first above-average hour that follows a below-average
//              hour, continuing into tomorrow's prices when they are published.
//              The night valley is no longer split at midnight (no more
//              charging at 23h when 03h is cheaper) and a late-evening cheap
//              hour no longer makes the planner skip a midday dip
//          (2) pre-discharge before negative prices is limited to what the
//              negative window can refill (hours x max charge rate) — it used
//              to empty the battery to 15% for a single negative hour. The
//              stop level is passed to the EMS as msg.preDischargeTargetSoC
//          (3) solar pre-discharge has a fixed target SoC (room for the expected
//              solar + 3 kWh of cheap grid charging) and is latched until that
//              level is reached — the target used to move down with the SoC and
//              the discharge stopped as soon as the overfill flag cleared
//          (4) no fake average: when today's prices are missing, msg.avgPrice is
//              the last average calculated today, or null — it used to be 0.10
//              (or, in the flow, the current price itself)
//          (5) quarter-hour price arrays are averaged to hourly values first;
//              msg.currentPrice is the exact slot that contains "now"
//          (6) the current negative hour counts only for the part that is left
//          (7) msg.solarNow is optional: without it the planner uses the solar
//              production the EMS stored on its previous run (flow context)
//          (8) SoC 0% is no longer read as "unknown"
// v2.15 - bug fixes from simulation review —
//          (1) crash (whole flow stops, EMS never runs) when the price array has
//              no remaining hours for today; now falls back like "no prices"
//          (2) MAX_AMPS 200 → 100 to match the EMS (100A since EMS v3.42); the
//              charge window was sized for 8.16 kW while the battery charges at
//              ~4.1 kW → only half the hours needed; MAX_DISCHARGE_KW is now
//              derived from MAX_AMPS (4.8 kW, was hardcoded 9.6)
//          (3) charge window never expands into above-average hours
//          (4) solar-before-cheap-window capped by the remaining forecast — the
//              current rate × hours ran past sunset and falsely flagged overfill
//          (5) no overfill flag without solar (0 >= 0 triggered it when full)
//          (6) solar pre-discharge frees at least 3 kWh when possible — it was
//              capped by headroom, so a near-full battery freed almost nothing
//          (7) hour/date taken from the parsed timestamp, not the string —
//              correct for both local-offset and UTC ('Z') timestamps
// v2.14 - solar overfill pre-discharge: if solar forecast will fill the battery
//          before the cheap window opens, discharge now to make room for cheap grid charging
// v2.13 - discharge window centered on most expensive hour and expanded outward
// v2.12 - charge window only built when cheapestPrice <= chargePriceCap;
//          prevents building a window around expensive hours at night
// v2.11 - pre-discharge before upcoming negative price windows;
//          if negative prices are forecast ahead, discharge now to free capacity
// v2.10 - count remaining negative price hours and pass to EMS so negative
//          price charging is spread across the full negative window instead of max rate
// v2.9 - charge window expansion biased toward earlier hours when neighbour prices
//         are within EARLY_BIAS_EUR of each other; keeps grid charging before solar peak
// v2.8 - solar forecast (energy_production_remaining_today) deducted from kwhNeeded;
//         grid charge window shrinks when solar will cover part of the charge
// v2.7 - discharge band filter raised to avgPrice (hours below avg can never be discharge hours)
// v2.6 - charge window centered on cheapest hour, expanded outward; price cap
//         replaced by contiguous window logic — lowest price sits in center of charge period
// v2.5 - dynamic CHARGE_ABS_RATIO/DISCHARGE_ABS_RATIO aligned with EMS v3.4
// v2.4 - avgPrice and currentPrice calculated from Frank Energie array, EnergyZero removed
// v2.3 - version defined as single variable at top
// v2.2 - SOC_NORMAL_THRESHOLD raised to 80%
// v2.1 - fixed msg.plannerVersion, DISCHARGE_ABS_MIN corrected
// v2.0 - dischargeThreshold recalculated after conflict filter

var PLANNER_VERSION      = 'v2.16';
var BATTERY_KWH          = 40;
var BATTERY_VOLTAGE      = 48;
var MAX_AMPS             = 100;   // must match EMS CFG.MAX_AMPS
var ROUND_TRIP_EFF       = 0.85;
var SOC_MIN              = 10;
var SOC_MAX              = 95;
var SAFETY_BUFFER_H      = 1;
var SOC_NORMAL_THRESHOLD = 80;    // above this, use tight charge cap
var CHARGE_ABS_RATIO     = 0.55;  // tight cap = avg * this (mirrors EMS)
var DISCHARGE_ABS_RATIO  = 0.55;  // min discharge price = avg * this (mirrors EMS)
var SOLAR_FORECAST_EFF   = 0.90;  // how much of the solar forecast actually reaches the battery
var EARLY_BIAS_EUR       = 0.02;  // prefer earlier hour when price difference is within this margin
var LATE_BIAS_EUR        = 0.02;  // prefer later hour when discharge neighbour prices are within this margin
var MAX_DISCHARGE_KW     = MAX_AMPS * BATTERY_VOLTAGE / 1000;
var SOLAR_OVERFILL_RATIO = 1.0;   // solar usable / headroom ratio above which overfill is expected
var SOLAR_PRE_MIN_HOURS  = 1;     // minimum hours before cheap window needed for pre-discharge
var SOC_DISCHARGE_MAX    = 95;    // SoC the discharge window is sized for (a full battery)
var SOC_DISCHARGE_MIN_PL = 15;    // SoC floor for discharge
var MIN_GRID_CHEAP_KWH   = 3.0;   // room to always keep for grid charging at the cheapest price
var SOLAR_NOW_MAX_AGE_MS = 5 * 60 * 1000;   // how old the EMS-stored solar value may be
var MAX_HORIZON_SLOTS    = 24;    // charge window never looks further than 24 h ahead

var maxChargeKw = (MAX_AMPS * BATTERY_VOLTAGE / 1000) * ROUND_TRIP_EFF;

var now   = new Date();
var nowMs = now.getTime();

var pad2      = function(n) { return String(n).padStart(2, '0'); };
var dateKeyOf = function(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); };
var localDateStr = dateKeyOf(now);
var currentHour  = now.getHours();

// ── Battery SoC ───────────────────────────────────────────────────────────────
// Unknown SoC: use the last known value, else 50% — for planning only. The EMS
// has its own check and keeps the battery idle when the SoC is really unknown.
var socRaw  = parseFloat(msg.batterySoC);
var lastSoC = parseFloat(context.get('lastSoC'));
var batterySoC = !isNaN(socRaw) ? socRaw : (!isNaN(lastSoC) ? lastSoC : 50);
if (!isNaN(socRaw)) { context.set('lastSoC', socRaw); }

// ── Current solar production (W) ──────────────────────────────────────────────
// msg.solarNow when a "Set solarNow" node is in the chain; otherwise the value
// the EMS Decision Engine stored on its previous run (at most a few seconds old).
var solarNow_W = parseFloat(msg.solarNow);
if (isNaN(solarNow_W)) {
  solarNow_W = 0;
  if (typeof flow !== 'undefined') {
    var storedSolarW  = parseFloat(flow.get('emsSolarNowW'));
    var storedSolarTs = parseFloat(flow.get('emsSolarNowTs'));
    if (!isNaN(storedSolarW) && !isNaN(storedSolarTs) && (nowMs - storedSolarTs) <= SOLAR_NOW_MAX_AGE_MS) {
      solarNow_W = storedSolarW;
    }
  }
}

// Solar forecast — kWh still expected today (Forecast.Solar); 0 when unavailable
var solarForecastKwh = parseFloat(msg.solarForecastRemaining) || 0;
var solarUsableKwh   = solarForecastKwh * SOLAR_FORECAST_EFF;

var usableCapacity = BATTERY_KWH * ((SOC_MAX - SOC_MIN) / 100);
var currentKwh     = BATTERY_KWH * ((batterySoC - SOC_MIN) / 100);
var kwhNeeded      = Math.max(0, usableCapacity - currentKwh);

// First estimate, refined below once the cheap window is known
var kwhFromGrid = Math.max(0, kwhNeeded - solarUsableKwh);
var hoursNeeded = Math.ceil(kwhFromGrid / maxChargeKw) + SAFETY_BUFFER_H;

// Accept Frank Energie price array in either format
var prices = null;
if (Array.isArray(msg.frankPrices)) {
  prices = msg.frankPrices;
} else if (msg.frankPrices && Array.isArray(msg.frankPrices.prices)) {
  prices = msg.frankPrices.prices;
}

var setFallback = function(reason) {
  // Average: only a real one. The last average calculated today, else null —
  // the EMS switches its price-ratio rules off when the average is unknown.
  var lastAvg     = parseFloat(context.get('lastAvgPrice'));
  var lastAvgDate = context.get('lastAvgDate');
  msg.avgPrice = (!isNaN(lastAvg) && lastAvgDate === localDateStr) ? String(lastAvg) : null;
  context.set('solarPreActive', false);

  msg.plannerVersion             = PLANNER_VERSION;
  msg.inChargingWindow           = null;
  msg.inDischargeWindow          = null;
  msg.dischargeThreshold         = null;
  msg.plannedChargeHours         = [];
  msg.plannedDischargeHours      = [];
  msg.hoursNeeded                = hoursNeeded;
  msg.kwhNeeded                  = parseFloat(kwhNeeded.toFixed(2));
  msg.kwhFromGrid                = parseFloat(kwhFromGrid.toFixed(2));
  msg.solarForecastKwh           = parseFloat(solarUsableKwh.toFixed(2));
  msg.cheapestPrice              = null;
  msg.cheapestHour               = null;
  msg.negPriceHoursRemaining     = 0;
  msg.inPreDischargeWindow       = false;
  msg.preDischargeHours          = [];
  msg.preDischargeTargetSoC      = SOC_DISCHARGE_MIN_PL;
  msg.hoursUntilNegWindow        = null;
  msg.futureNegHoursCount        = 0;
  msg.inSolarPreDischargeWindow  = false;
  msg.solarPreDischargeHours     = [];
  msg.solarPreDischargeTargetSoC = SOC_DISCHARGE_MIN_PL;
  msg.kwhToFreeForSolar          = 0;
  msg.solarWillOverfill          = false;
  msg.solarAfterCheapWindow      = 0;
  msg.kwhNeededForGrid           = parseFloat(kwhFromGrid.toFixed(2));
  msg.plannerReason              = reason + ' - using ratio fallback';
  node.status({ fill: 'yellow', shape: 'dot', text: PLANNER_VERSION + ' ' + reason + ' - fallback mode' });
};

if (!prices || prices.length === 0) {
  setFallback('No price schedule available');
  return msg;
}

// ── Parse the price array ─────────────────────────────────────────────────────
// Every valid entry is put in its local hour. Several entries in one hour
// (quarter-hour prices) are averaged, so the rest of the planner always works
// with one price per hour. The exact entry that contains "now" gives
// msg.currentPrice.
var hourMap   = {};
var hourSlots = [];
var currentPriceCalc = null;

for (var i = 0; i < prices.length; i++) {
  var p = prices[i];
  if (!p) continue;
  var fromDate = new Date(p.from);
  var tillDate = new Date(p.till);
  var priceVal = parseFloat(p.price);
  if (isNaN(fromDate.getTime()) || isNaN(tillDate.getTime()) || isNaN(priceVal)) continue;

  if (fromDate.getTime() <= nowMs && nowMs < tillDate.getTime()) {
    currentPriceCalc = priceVal;
  }

  // Hour key from the parsed timestamp — correct for local-offset and UTC ('Z')
  // timestamps. The UTC hour is added so the two 02:00 hours of the autumn
  // clock change stay separate.
  var hKey = dateKeyOf(fromDate) + 'T' + pad2(fromDate.getHours()) + '/' + fromDate.getUTCHours();
  var slot = hourMap[hKey];
  if (!slot) {
    slot = { from: fromDate, till: tillDate, sum: 0, n: 0, price: 0, localHour: fromDate.getHours(), dateStr: dateKeyOf(fromDate) };
    hourMap[hKey] = slot;
    hourSlots.push(slot);
  }
  slot.sum += priceVal;
  slot.n++;
  if (fromDate < slot.from) slot.from = fromDate;
  if (tillDate > slot.till) slot.till = tillDate;
}
for (var hs = 0; hs < hourSlots.length; hs++) {
  hourSlots[hs].price = hourSlots[hs].sum / hourSlots[hs].n;
}
hourSlots.sort(function(a, b) { return a.from - b.from; });

// Today's average, and the hours of today that are still to come
var totalPrice     = 0;
var todayCount     = 0;
var remainingToday = [];
for (var t = 0; t < hourSlots.length; t++) {
  if (hourSlots[t].dateStr !== localDateStr) continue;
  totalPrice += hourSlots[t].price;
  todayCount++;
  if (hourSlots[t].till > now) remainingToday.push(hourSlots[t]);
}

// No (remaining) hours for today — array holds only tomorrow, or stale data
if (todayCount === 0 || remainingToday.length === 0) {
  setFallback('No remaining price hours for today');
  return msg;
}

var avgPriceCalc = totalPrice / todayCount;
context.set('lastAvgPrice', avgPriceCalc);
context.set('lastAvgDate',  localDateStr);

if (currentPriceCalc === null && remainingToday[0].from <= now) {
  currentPriceCalc = remainingToday[0].price;
}

// Override msg so the EMS uses Frank Energie prices
msg.currentPrice = currentPriceCalc !== null ? String(currentPriceCalc) : msg.currentPrice;
msg.avgPrice     = String(avgPriceCalc);

// Dynamic price caps based on today's average (mirrors EMS CFG ratios)
var chargePriceCap  = batterySoC >= SOC_NORMAL_THRESHOLD
  ? avgPriceCalc * CHARGE_ABS_RATIO      // tight: SoC healthy
  : avgPriceCalc * 0.99;                 // expanded: SoC low — any below-avg hour qualifies
var dischargeAbsMin = avgPriceCalc * DISCHARGE_ABS_RATIO;

// ── Charge horizon: the current price valley ──────────────────────────────────
// From now until the first above-average hour that comes after a below-average
// hour. It continues past midnight when tomorrow's prices are in the array, so
// the charge window is centred on the real bottom of the valley. Index 0 is
// always the current hour.
var chargeHorizon = [];
var seenBelowAvg  = false;
var seenHours     = {};
for (var ch = 0; ch < hourSlots.length; ch++) {
  var hSlot = hourSlots[ch];
  if (!(hSlot.till > now)) continue;
  if (seenHours[hSlot.localHour]) break;                       // never the same clock hour twice
  if (seenBelowAvg && hSlot.price >= avgPriceCalc) break;      // the valley ends here
  if (hSlot.price < avgPriceCalc) seenBelowAvg = true;
  seenHours[hSlot.localHour] = true;
  chargeHorizon.push(hSlot);
  if (chargeHorizon.length >= MAX_HORIZON_SLOTS) break;
}

// Cheapest hour of the valley = centre of the charge window
var centerIdx = 0;
for (var ci = 1; ci < chargeHorizon.length; ci++) {
  if (chargeHorizon[ci].price < chargeHorizon[centerIdx].price) centerIdx = ci;
}
var cheapestPrice     = chargeHorizon[centerIdx].price;
var cheapestHour      = chargeHorizon[centerIdx].localHour;
var cheapestIsToday   = chargeHorizon[centerIdx].dateStr === localDateStr;
var chargeWindowValid = cheapestPrice <= chargePriceCap;
var hoursUntilCheapWindow = centerIdx;          // index 0 = current hour
var windowNotYetOpen      = centerIdx > 0;

// ── Negative prices today ─────────────────────────────────────────────────────
// Hours with a negative price that are left today. The current hour counts only
// for the part that is still to come, so the EMS spreads the charge correctly.
var negPriceHoursRemaining = 0;
var futureNegHours  = [];        // negative hours after the current hour
var firstNegHourIdx = -1;
for (var np = 0; np < remainingToday.length; np++) {
  if (remainingToday[np].price >= 0) continue;
  if (np === 0 && remainingToday[0].from <= now) {
    var hourLen = remainingToday[0].till.getTime() - remainingToday[0].from.getTime();
    negPriceHoursRemaining += Math.max(0.25, Math.min(1, (remainingToday[0].till.getTime() - nowMs) / hourLen));
  } else {
    negPriceHoursRemaining += 1;
    futureNegHours.push(remainingToday[np]);
    if (firstNegHourIdx === -1) firstNegHourIdx = np;
  }
}
negPriceHoursRemaining = parseFloat(negPriceHoursRemaining.toFixed(2));
var hoursUntilNegWindow = firstNegHourIdx !== -1 ? firstNegHourIdx : 99;

// ── Pre-discharge before a negative price window ──────────────────────────────
// Only free what the negative window can put back: hours × max charge rate.
// The EMS discharges down to preDischargeTargetSoC and no further.
var negRefillKwh          = futureNegHours.length * maxChargeKw;
var preDischargeTargetSoC = Math.max(SOC_DISCHARGE_MIN_PL,
  Math.ceil(SOC_MAX - (negRefillKwh / BATTERY_KWH * 100)));
var capacityToFree = Math.max(0, BATTERY_KWH * ((batterySoC - preDischargeTargetSoC) / 100));

var preDischargeHours = [];
if (futureNegHours.length > 0 && firstNegHourIdx > 0) {
  for (var pd = 0; pd < firstNegHourIdx; pd++) {
    var pdHour = remainingToday[pd];
    // Only hours worth discharging in (above avg × DISCHARGE_ABS_RATIO, not negative)
    if (pdHour.price >= dischargeAbsMin && pdHour.price >= 0) {
      preDischargeHours.push(pdHour.localHour);
    }
  }
}

var inPreDischargeWindow = preDischargeHours.indexOf(currentHour) !== -1
  && futureNegHours.length > 0
  && batterySoC > preDischargeTargetSoC
  && capacityToFree > 0;

// ── Solar that still arrives before / after the cheap window ──────────────────
// Current production rate × hours until the cheap window, capped by what is
// left of today's forecast (the current rate does not last past sunset).
var solarRateKw            = solarNow_W / 1000;
var solarBeforeCheapWindow = Math.min(solarRateKw * hoursUntilCheapWindow, solarUsableKwh);
var solarAfterCheapWindow  = Math.max(0, solarUsableKwh - solarBeforeCheapWindow);

// Grid only has to cover what the solar AFTER the cheap window will not
kwhFromGrid = Math.max(0, kwhNeeded - solarAfterCheapWindow);
hoursNeeded = Math.ceil(kwhFromGrid / maxChargeKw) + SAFETY_BUFFER_H;

// ── Solar overfill pre-discharge ──────────────────────────────────────────────
// If the solar still to come before the cheap window would fill the battery,
// discharge now so that at the cheap window there is room for that solar plus
// MIN_GRID_CHEAP_KWH of cheap grid energy. The target SoC follows from the solar
// estimate only (not from the current SoC), and the action is latched until the
// target is reached — it does not stop the moment the overfill flag clears.
var currentHeadroom = Math.max(0, usableCapacity - currentKwh);

var solarOverfillTrigger = chargeWindowValid
  && cheapestIsToday
  && windowNotYetOpen
  && solarBeforeCheapWindow > 0
  && solarBeforeCheapWindow >= currentHeadroom * SOLAR_OVERFILL_RATIO;

var requiredHeadroomKwh        = solarBeforeCheapWindow + MIN_GRID_CHEAP_KWH;
var solarPreDischargeTargetSoC = Math.max(SOC_DISCHARGE_MIN_PL,
  Math.floor(SOC_MAX - (requiredHeadroomKwh / BATTERY_KWH * 100)));

var solarPreLatched   = context.get('solarPreActive') === true;
var solarWillOverfill = (solarOverfillTrigger || solarPreLatched)
  && chargeWindowValid
  && cheapestIsToday
  && windowNotYetOpen
  && solarBeforeCheapWindow > 0
  && batterySoC > solarPreDischargeTargetSoC;
context.set('solarPreActive', solarWillOverfill);

var kwhToFreeForSolar         = 0;
var solarPreDischargeHours    = [];
var inSolarPreDischargeWindow = false;

if (solarWillOverfill) {
  kwhToFreeForSolar = Math.max(0, BATTERY_KWH * ((batterySoC - solarPreDischargeTargetSoC) / 100));

  // Pre-discharge hours: from now until the cheap window, price above dischargeAbsMin
  for (var sp = 0; sp < centerIdx; sp++) {
    var spHour = chargeHorizon[sp];
    if (spHour.price >= dischargeAbsMin && spHour.price >= 0) {
      solarPreDischargeHours.push(spHour.localHour);
    }
  }

  inSolarPreDischargeWindow = solarPreDischargeHours.indexOf(currentHour) !== -1
    && solarPreDischargeHours.length >= SOLAR_PRE_MIN_HOURS;
} else {
  solarPreDischargeTargetSoC = SOC_DISCHARGE_MIN_PL;
}

// ── Charge window ─────────────────────────────────────────────────────────────
// Centred on the cheapest hour of the valley, expanding outward to the cheaper
// neighbour until hoursNeeded hours are filled. Contiguous in time, never into
// above-average hours.
var windowIndices = [centerIdx];
var left  = centerIdx - 1;
var right = centerIdx + 1;

while (windowIndices.length < hoursNeeded) {
  var canLeft  = left >= 0                   && chargeHorizon[left].price  < avgPriceCalc;
  var canRight = right < chargeHorizon.length && chargeHorizon[right].price < avgPriceCalc;
  if (!canLeft && !canRight) break;

  var pickLeft;
  if      (!canRight) { pickLeft = true; }
  else if (!canLeft)  { pickLeft = false; }
  else {
    // Prefer the earlier hour unless the later one is cheaper by more than the
    // bias margin — keeps grid charging before the solar peak.
    var priceDiff = chargeHorizon[right].price - chargeHorizon[left].price;
    pickLeft = priceDiff >= -EARLY_BIAS_EUR;
  }

  if (pickLeft) { windowIndices.push(left);  left--;  }
  else          { windowIndices.push(right); right++; }
}

// No window when even the cheapest hour of the valley is above the price cap —
// the EMS then uses its ratio-based logic only.
var cheapestHours = [];
var inWindow      = false;
if (chargeWindowValid) {
  windowIndices.sort(function(a, b) { return a - b; });
  for (var wi = 0; wi < windowIndices.length; wi++) {
    cheapestHours.push(chargeHorizon[windowIndices[wi]].localHour);   // in time order
  }
  inWindow = windowIndices.indexOf(0) !== -1;
}

// ── Discharge window (remaining hours of today) ───────────────────────────────
// Sized for a full battery at maximum rate. The EMS only covers the house load,
// so in practice this is "up to N above-average hours around the day's peak".
var kwhToDischarge       = BATTERY_KWH * ((SOC_DISCHARGE_MAX - SOC_DISCHARGE_MIN_PL) / 100);
var dischargeHoursNeeded = Math.min(Math.ceil(kwhToDischarge / MAX_DISCHARGE_KW) + 1, remainingToday.length);

// Most expensive remaining hour (above avgPrice) as window centre
var dCenterIdx = -1;
for (var dp = 0; dp < remainingToday.length; dp++) {
  if (remainingToday[dp].price < avgPriceCalc) continue;
  if (dCenterIdx === -1 || remainingToday[dp].price > remainingToday[dCenterIdx].price) dCenterIdx = dp;
}

var expensiveHours     = [];
var dischargeThreshold = null;

if (dCenterIdx !== -1) {
  // Expand outward. LATE_BIAS_EUR: when neighbours are within the margin, prefer
  // the later hour to keep the window anchored in the evening peak band.
  var dWindowIdx = [dCenterIdx];
  var dLeft  = dCenterIdx - 1;
  var dRight = dCenterIdx + 1;

  while (dWindowIdx.length < dischargeHoursNeeded) {
    var dCanLeft  = dLeft  >= 0                    && remainingToday[dLeft].price  >= avgPriceCalc;
    var dCanRight = dRight < remainingToday.length && remainingToday[dRight].price >= avgPriceCalc;
    if (!dCanLeft && !dCanRight) break;

    var dPickLeft;
    if      (!dCanRight) { dPickLeft = true; }
    else if (!dCanLeft)  { dPickLeft = false; }
    else {
      var dDiff = remainingToday[dLeft].price - remainingToday[dRight].price;
      dPickLeft = dDiff > LATE_BIAS_EUR;  // only pick left if meaningfully more expensive
    }

    if (dPickLeft) { dWindowIdx.push(dLeft);  dLeft--;  }
    else           { dWindowIdx.push(dRight); dRight++; }
  }
  dWindowIdx.sort(function(a, b) { return a - b; });

  // Skip hours that are also charge hours; threshold = lowest price in the window
  for (var dw = 0; dw < dWindowIdx.length; dw++) {
    var dSlot = remainingToday[dWindowIdx[dw]];
    if (cheapestHours.indexOf(dSlot.localHour) !== -1) continue;
    expensiveHours.push(dSlot.localHour);
    if (dischargeThreshold === null || dSlot.price < dischargeThreshold) dischargeThreshold = dSlot.price;
  }
}

var inDischargeWindow = expensiveHours.indexOf(currentHour) !== -1;

// ── Output ────────────────────────────────────────────────────────────────────
msg.plannerVersion             = PLANNER_VERSION;
msg.inChargingWindow           = inWindow;
msg.inDischargeWindow          = inDischargeWindow;
msg.dischargeThreshold         = dischargeThreshold;
msg.plannedChargeHours         = cheapestHours;
msg.plannedDischargeHours      = expensiveHours;
msg.hoursNeeded                = hoursNeeded;
msg.kwhNeeded                  = parseFloat(kwhNeeded.toFixed(2));
msg.kwhFromGrid                = parseFloat(kwhFromGrid.toFixed(2));
msg.solarForecastKwh           = parseFloat(solarUsableKwh.toFixed(2));
msg.cheapestPrice              = cheapestPrice;
msg.cheapestHour               = cheapestHour;
msg.negPriceHoursRemaining     = negPriceHoursRemaining;
msg.inPreDischargeWindow       = inPreDischargeWindow;
msg.preDischargeHours          = preDischargeHours;
msg.preDischargeTargetSoC      = preDischargeTargetSoC;
msg.hoursUntilNegWindow        = hoursUntilNegWindow < 99 ? hoursUntilNegWindow : null;
msg.futureNegHoursCount        = futureNegHours.length;
msg.inSolarPreDischargeWindow  = inSolarPreDischargeWindow;
msg.solarPreDischargeHours     = solarPreDischargeHours;
msg.solarPreDischargeTargetSoC = solarPreDischargeTargetSoC;
msg.kwhToFreeForSolar          = parseFloat(kwhToFreeForSolar.toFixed(2));
msg.solarWillOverfill          = solarWillOverfill;
msg.solarAfterCheapWindow      = parseFloat(solarAfterCheapWindow.toFixed(2));
msg.kwhNeededForGrid           = parseFloat(kwhFromGrid.toFixed(2));

var hoursText = function(list) { return list.map(function(h) { return h + 'h'; }).join(', '); };

msg.plannerReason =
  'Need ' + kwhNeeded.toFixed(1) + ' kWh total' +
    (solarUsableKwh > 0 ? ', solar covers ~' + solarUsableKwh.toFixed(1) + ' kWh, ' + kwhFromGrid.toFixed(1) + ' kWh from grid (' + hoursNeeded + 'h)' : ' from grid (' + hoursNeeded + 'h)') + '. ' +
  'SoC ' + batterySoC + '% - cheapest hour: ' + cheapestHour + 'h' + (cheapestIsToday ? '' : ' tomorrow') + ' (' + cheapestPrice.toFixed(3) + ' EUR), window centered there. ' +
  'Avg: ' + avgPriceCalc.toFixed(3) + ' EUR. ' +
  'Charge hours: ' + hoursText(cheapestHours) +
  '. Discharge hours: ' + hoursText(expensiveHours) +
  '. Discharge threshold: ' + (dischargeThreshold !== null ? dischargeThreshold.toFixed(3) : '?') + ' EUR' +
  '. In charge window: ' + inWindow +
  '. In discharge window: ' + inDischargeWindow +
  (futureNegHours.length > 0 ? '. Neg price in ' + hoursUntilNegWindow + 'h (' + futureNegHours.length + ' neg hour(s)), pre-discharge to ' + preDischargeTargetSoC + '%: ' + inPreDischargeWindow : '') +
  (solarWillOverfill ? '. Solar overfill expected — pre-discharge to ' + solarPreDischargeTargetSoC + '% (' + kwhToFreeForSolar.toFixed(1) + ' kWh). Solar pre-dch: ' + inSolarPreDischargeWindow : '') +
  '. Solar after window: ' + solarAfterCheapWindow.toFixed(1) + ' kWh';

node.status({
  fill:  inWindow ? 'green' : inDischargeWindow ? 'red' : 'grey',
  shape: 'dot',
  text:  PLANNER_VERSION + ' ' + (inWindow ? 'CHG' : inDischargeWindow ? 'DCH' : 'IDLE') +
    ' | SoC:' + batterySoC + '% cap:' + chargePriceCap.toFixed(2) +
    ' | dch>' + (dischargeThreshold !== null ? dischargeThreshold.toFixed(3) : '?') + 'EUR' +
    ' | hour ' + currentHour + 'h'
});

return msg;
